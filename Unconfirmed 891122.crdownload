/* =========================================================
   مدیریت پذیرایی موعود — app.js
   کاملاً سمت مرورگر؛ بدون سرور و بدون ردیابی
   ========================================================= */
'use strict';

/* ---------- ابزار امنیتی/خطا ---------- */
function safeLS(){
  try{
    var t='__maoud_test__';
    localStorage.setItem(t,'1'); localStorage.removeItem(t);
    return localStorage;
  }catch(e){ return null; }
}
var LS = safeLS();

/* ---------- ذخیره‌سازی ---------- */
var STORAGE_KEY = 'maoud-food-panel-v1';
var DEFAULTS = {
  budgets: { lunch: 280000, breakfast: 100000 },
  records: []
};
function loadState(){
  if(!LS) return JSON.parse(JSON.stringify(DEFAULTS));
  try{
    var raw = LS.getItem(STORAGE_KEY);
    if(!raw) return JSON.parse(JSON.stringify(DEFAULTS));
    var st = JSON.parse(raw);
    st.budgets = st.budgets || {};
    var d = JSON.parse(JSON.stringify(DEFAULTS));
    d.budgets.lunch = toEnDigits(String(st.budgets.lunch==null?d.budgets.lunch:st.budgets.lunch)).trim();
    d.budgets.breakfast = toEnDigits(String(st.budgets.breakfast==null?d.budgets.breakfast:st.budgets.breakfast)).trim();
    d.budgets.lunch = Math.max(0, parseInt(d.budgets.lunch,10)||DEFAULTS.budgets.lunch);
    d.budgets.breakfast = Math.max(0, parseInt(d.budgets.breakfast,10)||DEFAULTS.budgets.breakfast);
    d.records = Array.isArray(st.records)? st.records.filter(validRecord):[];
    return d;
  }catch(e){ console.warn('خطا در خواندن داده‌ها', e); return JSON.parse(JSON.stringify(DEFAULTS)); }
}
function validRecord(r){
  return r && typeof r.date==='string' && /^\d{4}\/\d{2}\/\d{2}$/.test(r.date)
      && (r.meal==='lunch'||r.meal==='breakfast')
      && typeof r.attendees==='number' && r.attendees>0
      && typeof r.totalCost==='number' && isFinite(r.totalCost) && r.totalCost>=0;
}
function saveState(){
  if(!LS){ toast('مرورگر شما ذخیره‌سازی محلی را پشتیبانی نمی‌کند؛ داده‌ها فقط تا بستن صفحه می‌مانند.','bad'); return; }
  try{ LS.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch(e){ toast('ذخیره‌سازی ناموفق بود (حافظه پر یا غیرفعال است).','bad'); }
}
var state = loadState();

/* ---------- ارقام و اعداد ---------- */
var FA = '۰۱۲۳۴۵۶۷۸۹', AR = '٠١٢٣٤٥٦٧٨٩';
function toEnDigits(s){
  if(typeof s!=='string') s = String(s==null?'':s);
  var out='';
  for(var i=0;i<s.length;i++){
    var c = s[i];
    var fi = FA.indexOf(c), ai = AR.indexOf(c);
    out += fi>-1? String(fi) : (ai>-1? String(ai) : c);
  }
  return out;
}
function toFaDigits(s){
  if(typeof s!=='string') s = String(s==null?'':s);
  var out='';
  for(var i=0;i<s.length;i++){
    var d = s.charCodeAt(i);
    out += (d>=48&&d<=57)? FA[d-48] : s[i];
  }
  return out;
}
function parseAmount(v){
  var s = toEnDigits(String(v==null?'':v)).trim();
  s = s.replace(/[٬،,\s]/g,'');
  var f = s.match(/^(\d+)([٫.])(\d*)$/);
  if(f){
    // اگر بعد از ممیز فقط صفر آمده (مثل ۲۱۰۰۰۰۰.۰۰) حذف می‌شود، در غیر این صورت گرد می‌شود
    if(!/[1-9]/.test(f[3]||'')) s = f[1];
    else s = String(Math.round(parseFloat(f[1]+'.'+(f[3]||'0'))));
  }
  s = s.replace(/[^0-9]/g,'');
  if(!s) return NaN;
  return parseInt(s,10);
}
function fmtMoney(n){ // تومان با جداکننده هزارگان و ارقام فارسی
  n = Math.round(Number(n)||0);
  var s = Math.abs(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,'٬');
  return toFaDigits((n<0?'−':'')+s);
}
function fmtNum(n){ return toFaDigits(String(n)); }

/* ---------- تاریخ شمسی (Intl) ---------- */
var jalaliOK = false;
var fmtParts = null;
function detectJalali(){
  try{
    fmtParts = new Intl.DateTimeFormat('en-US-u-ca-persian',{year:'numeric',month:'numeric',day:'numeric',timeZone:'UTC'});
    var probe = fmtParts.formatToParts(new Date(Date.UTC(2026,9,21)));
    var o = {};
    probe.forEach(function(p){ if(p.type!=='literal') o[p.type]=p.value; });
    jalaliOK = String(o.year||'').indexOf('1405')>-1 && String(o.month)==='7' && String(o.day)==='29';
  }catch(e){ jalaliOK = false; fmtParts = null; }
}
detectJalali();

function g2j(dateUTC){
  // dateUTC: Date در نیمه‌شب UTC
  if(!jalaliOK) return null;
  var p = fmtParts.formatToParts(dateUTC);
  var o={};
  p.forEach(function(x){ if(x.type!=='literal') o[x.type]=x.value; });
  var year = parseInt(toEnDigits(o.year).replace(/[^0-9]/g,''),10);
  var month = parseInt(toEnDigits(o.month),10);
  var day = parseInt(toEnDigits(o.day),10);
  if(!year||!month||!day) return null;
  return {jy:year, jm:month, jd:day};
}
function j2g(jy,jm,jd){
  if(!jalaliOK) return null;
  // جست‌وجوی خطی روی تقریب میلادی + راستی‌آزمایی با Intl (دقیق حتی در سال کبیسه)
  var guess = new Date(Date.UTC(jy+621, jm-1, Math.min(jd,28)));
  var start = new Date(guess.getTime() - 60*86400000);
  for(var i=0;i<=130;i++){
    var d = new Date(start.getTime() + i*86400000);
    var j = g2j(d);
    if(j && j.jy===jy && j.jm===jm && j.jd===jd) return d;
  }
  return null;
}
function todayJ(){
  var now = new Date();
  var local = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  var offsetMin = now.getTimezoneOffset();
  var utcNoon = new Date(local.getTime() - offsetMin*60000 + 12*3600000); // ظهر محلی → جلوگیری از خطای منطقه زمانی
  var j = g2j(utcNoon);
  if(!j) return null;
  return padJ(j);
}
function padJ(j){ return {jy:j.jy, jm:j.jm, jd:j.jd, str:j.jy+'/'+pad2(j.jm)+'/'+pad2(j.jd)}; }
function pad2(n){ return (n<10?'0':'')+n; }

var WEEK = ['شنبه','یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه'];
function weekdayIndex(dateStr){ // 0=شنبه … 6=جمعه
  var g = jStrToUTC(dateStr);
  if(!g) return -1;
  return (g.getUTCDay()+1)%7;
}
function jStrToUTC(dateStr){
  var parts = parseDateStr(dateStr);
  if(!parts) return null;
  return j2g(parts.jy,parts.jm,parts.jd);
}
function parseDateStr(v){
  var s = toEnDigits(String(v==null?'':v)).trim().replace(/[-.\\\u066B]/g,'/');
  var m = s.match(/^(\d{3,4})\/(\d{1,2})\/(\d{1,2})$/);
  if(!m) return null;
  var jy=+m[1], jm=+m[2], jd=+m[3];
  if(jy<1300||jy>1600||jm<1||jm>12||jd<1||jd>31) return null;
  if(jm>6 && jd>30){
    // ماه‌های ۷ تا ۱۱ حداکثر ۳۰ روز، اسفند بسته به کبیسه
    if(jm<12 || !isJalaliLeap(jy)) return null;
    if(jm===12 && jd>30) return null;
  }
  if(!jalaliOK){ /* بدون Intl فقط ساختار معتبر */ }
  else if(!j2g(jy,jm,jd)) return null;
  return {jy:jy,jm:jm,jd:jd};
}
function isJalaliLeap(jy){
  if(!jalaliOK) return ((jy+2346)%33)%4===1; // تقریب
  var g = j2g(jy,12,30); // اسفند ۳۰ فقط در سال کبیسه معتبر است
  if(g){ var j=g2j(g); return !!(j && j.jy===jy && j.jm===12 && j.jd===30); }
  return false;
}
function parseMonthStr(v){
  var s = toEnDigits(String(v==null?'':v)).trim().replace(/[-.\\\u066B]/g,'/');
  var m = s.match(/^(\d{3,4})\/(\d{1,2})$/);
  if(!m) return null;
  var jy=+m[1], jm=+m[2];
  if(jy<1300||jy>1600||jm<1||jm>12) return null;
  return jy+'/'+pad2(jm);
}
var MONTHS = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
function monthLabel(ym){
  var p = ym.split('/'); return MONTHS[+p[1]-1]+' '+toFaDigits(p[0]);
}
function dateLabel(dateStr){
  var p = dateStr.split('/');
  return toFaDigits(p[0])+'/'+toFaDigits(p[1])+'/'+toFaDigits(p[2]);
}
function fullDateLabel(dateStr){
  var wi = weekdayIndex(dateStr);
  return (wi>=0? WEEK[wi]+' ':'')+dateLabel(dateStr);
}

/* ---------- تقویم کاری وعده‌ها ---------- */
var MEALS = {
  breakfast: { key:'breakfast', name:'صبحانه', days:[0,1,2,3,4,5] }, // شنبه تا پنجشنبه
  lunch:     { key:'lunch', name:'ناهار',   days:[0,1,2,3] }        // شنبه تا چهارشنبه
};
function mealAllowed(mealKey, dateStr){
  var wi = weekdayIndex(dateStr);
  if(wi<0) return false;
  return MEALS[mealKey].days.indexOf(wi)>-1;
}
function scheduleForWeek(mealKey, dateStr){
  // تاریخ‌های واجد شرایط این وعده در هفته ایرانیِ (شنبه تا جمعه) شامل dateStr
  var wi = weekdayIndex(dateStr);
  var saturdayUTC = jStrToUTC(dateStr);
  saturdayUTC = new Date(saturdayUTC.getTime() - wi*86400000);
  var out=[];
  for(var i=0;i<7;i++){
    var d = new Date(saturdayUTC.getTime()+i*86400000);
    var j = g2j(d);
    if(!j) continue;
    var s = padJ(j).str;
    if(MEALS[mealKey].days.indexOf(i)>-1) out.push(s);
  }
  return out;
}

/* ---------- پیشنهاد هفتگی ---------- */
function weeklySuggestion(mealKey, dateStr, attendees){
  var cap = state.budgets[mealKey];
  var sched = scheduleForWeek(mealKey, dateStr);
  var idx = sched.indexOf(dateStr);
  var remaining = sched.length - idx; // روزهای باقی‌مانده از تاریخ انتخابی تا آخرین روز مجاز، شامل امروز
  // ثبت‌های قبلی همین هفته، همین وعده، قبل از تاریخ انتخابی
  var prior = state.records.filter(function(r){
    return r.meal===mealKey && r.date<dateStr && sched.indexOf(r.date)>-1;
  });
  var priorPP = prior.map(function(r){ return r.totalCost / r.attendees; });
  var priorSum = priorPP.reduce(function(a,b){return a+b;},0);
  var n = prior.length;

  var ctx = {
    meal: MEALS[mealKey].name, cap: cap, priorCount: n,
    priorAvg: n? priorSum/n : 0,
    priorSum: priorSum,
    remaining: remaining,
    attendees: attendees
  };
  if(n===0){
    ctx.reason = 'noPrior';
    ctx.perPerson = cap; ctx.total = cap*attendees;
    return ctx;
  }
  // هدف: (priorSum + remaining*x)/(n+remaining) = cap  →  x = (cap*(n+remaining)-priorSum)/remaining
  var x = (cap*(n+remaining) - priorSum)/remaining;
  if(priorSum > cap*n + 1e-9){
    ctx.reason='over'; ctx.perPerson=0; ctx.total=0; ctx.raw=x;
  } else if(x > cap + 1e-9){
    ctx.reason='atCap'; ctx.perPerson=cap; ctx.total=cap*attendees; ctx.raw=x;
  } else {
    ctx.reason='normal'; ctx.perPerson=Math.max(0,Math.floor(x)); ctx.total=ctx.perPerson*attendees; ctx.raw=x;
  }
  return ctx;
}

/* ---------- کمکی‌های نمایش ---------- */
function el(tag, cls, text){
  var e = document.createElement(tag);
  if(cls) e.className = cls;
  if(text!=null) e.textContent = text; // امن: بدون HTML خام
  return e;
}
function findRecord(dateStr, mealKey){
  return state.records.find(function(r){ return r.date===dateStr && r.meal===mealKey; });
}
function perPerson(r){ return r.attendees>0 ? r.totalCost/r.attendees : 0; }
function capStatus(r){
  var cap = state.budgets[r.meal];
  return perPerson(r) > cap + 0.5 ? 'bad' : 'ok';
}

/* ---------- Toast / Modal ---------- */
var toastWrap = document.getElementById('toastWrap');
function toast(msg, kind){
  var t = el('div','toast'+(kind?' '+kind:''), msg);
  toastWrap.appendChild(t);
  setTimeout(function(){ t.classList.add('out'); setTimeout(function(){ t.remove(); }, 320); }, 3200);
}
var modal = document.getElementById('modal');
var modalText = document.getElementById('modalText');
var modalConfirm = document.getElementById('modalConfirm');
var modalCb = null;
function confirmDialog(title, text, cb, confirmLabel){
  document.getElementById('modalTitle').textContent = title;
  modalText.textContent = text;
  modalConfirm.textContent = confirmLabel || 'تأیید';
  modalCb = cb;
  modal.hidden = false;
  modalConfirm.focus();
}
modal.addEventListener('click', function(e){
  if(e.target.hasAttribute('data-close-modal')) modal.hidden = true;
});
modalConfirm.addEventListener('click', function(){
  modal.hidden = true;
  if(modalCb){ var cb=modalCb; modalCb=null; cb(); }
});
document.addEventListener('keydown', function(e){ if(e.key==='Escape' && !modal.hidden) modal.hidden = true; });

/* ---------- ناوبری ---------- */
var views = ['dashboard','workflow','records','report','settings'];
var navBtns = Array.prototype.slice.call(document.querySelectorAll('.nav-btn'));
function goto(view){
  if(views.indexOf(view)<0) return;
  views.forEach(function(v){
    document.getElementById('view-'+v).classList.toggle('is-active', v===view);
  });
  navBtns.forEach(function(b){
    var on = b.getAttribute('data-view')===view;
    b.classList.toggle('is-active', on);
    if(on) b.setAttribute('aria-current','page'); else b.removeAttribute('aria-current');
  });
  closeSidebar();
  var active = document.querySelector('.view.is-active');
  if(active){
    active.querySelectorAll('.card').forEach(function(c,i){ c.style.animationDelay=(i*40)+'ms'; });
    active.querySelectorAll('.card').forEach(function(c){ c.style.animation='none'; void c.offsetWidth; c.style.animation=''; });
  }
  if(view==='dashboard') renderDashboard();
  if(view==='records') renderRecords();
  if(view==='report') renderReport();
  if(view==='settings') renderSettings();
  document.getElementById('main').focus({preventScroll:true});
  window.scrollTo({top:0, behavior:'smooth'});
}
document.addEventListener('click', function(e){
  var b = e.target.closest('[data-goto]');
  if(!b) return;
  goto(b.getAttribute('data-goto'));
  if(b.getAttribute('data-focus')==='backup'){
    setTimeout(function(){ var s=document.getElementById('backup'); if(s) s.scrollIntoView({behavior:'smooth'}); },60);
  }
});

/* منوی موبایل */
var sidebar = document.querySelector('.sidebar');
var menuBtn = document.getElementById('menuToggle');
var scrim = null;
function closeSidebar(){ sidebar.classList.remove('open'); menuBtn.setAttribute('aria-expanded','false'); if(scrim){scrim.remove();scrim=null;} }
menuBtn.addEventListener('click', function(){
  var open = !sidebar.classList.contains('open');
  sidebar.classList.toggle('open', open);
  menuBtn.setAttribute('aria-expanded', String(open));
  if(open){
    scrim = el('div','scrim'); document.body.appendChild(scrim);
    scrim.addEventListener('click', closeSidebar);
  }
});

/* ---------- داشبورد ---------- */
var dashMonthInput = document.getElementById('dashMonth');
function monthOf(dateStr){ return dateStr.slice(0,7); }
function currentMonth(){
  var v = parseMonthStr(dashMonthInput.value);
  if(v) return v;
  var t = todayJ();
  return t? t.str.slice(0,7) : '';
}
function recordsForMonth(ym, meal){
  return state.records.filter(function(r){
    return (!ym || r.date.slice(0,7)===ym) && (!meal || r.meal===meal);
  });
}
function dayStatsForMonth(ym){
  // میانگین روزانه سرِ نفر (میانگین حسابیِ هزینه‌ی هر روز به ازای هر نفر)
  var recs = recordsForMonth(ym, null);
  var byKey = {};
  recs.forEach(function(r){
    var k = r.date+'|'+r.meal;
    (byKey[k] = byKey[k]||[]).push(r);
  });
  var days = Object.keys(byKey).map(function(k){
    var rs = byKey[k];
    var pp = rs.reduce(function(a,r){return a+perPerson(r);},0)/rs.length;
    var cost = rs.reduce(function(a,r){return a+r.totalCost;},0);
    var att = rs.reduce(function(a,r){return a+r.attendees;},0);
    return {date:rs[0].date, meal:rs[0].meal, perPerson:pp, cost:cost, attendees:att};
  });
  return days;
}
function renderDashboard(){
  var t = todayJ();
  var todayEl = document.getElementById('todayLine');
  var chip = document.getElementById('todayChip');
  if(t){
    todayEl.textContent = 'امروز: '+WEEK[weekdayIndex(t.str)]+'، '+dateLabel(t.str);
    chip.textContent = 'امروز '+dateLabel(t.str);
  }else{
    todayEl.textContent = 'تاریخ امروز در دسترس نیست (مرورگر قدیمی؟)';
    chip.textContent = '—';
  }
  var ym = currentMonth();
  document.getElementById('dashMonthName').textContent = ym? monthLabel(ym):'—';
  document.getElementById('dashDateLine').textContent = ym? 'ماه انتخابی: '+monthLabel(ym) : '';
  var statsEl = document.getElementById('dashStats');
  statsEl.innerHTML='';
  if(!ym){ statsEl.appendChild(el('p','muted','ماه نامعتبر است؛ قالب درست: YYYY/MM')); }
  var days = ym? dayStatsForMonth(ym):[];
  var recs = ym? recordsForMonth(ym,null):[];
  var mk = function(meal){ return days.filter(function(d){return d.meal===meal;}); };
  var bDays = mk('breakfast'), lDays = mk('lunch');
  var sum = function(arr,f){ return arr.reduce(function(a,d){return a+f(d);},0); };
  var att = sum(recs,function(r){return r.attendees;});
  var over = days.filter(function(d){ return d.perPerson > state.budgets[d.meal]+0.5; }).length;
  var avgPP = days.length? sum(days,function(d){return d.perPerson;})/days.length : 0;

  var cards = [
    {lbl:'هزینه صبحانه در ماه', val:fmtMoney(sum(bDays,function(d){return d.cost;}))+' تومان', sub:bDays.length? fmtNum(bDays.length)+' روز ثبت‌شده':'بدون ثبت'},
    {lbl:'هزینه ناهار در ماه', val:fmtMoney(sum(lDays,function(d){return d.cost;}))+' تومان', sub:lDays.length? fmtNum(lDays.length)+' روز ثبت‌شده':'بدون ثبت'},
    {lbl:'میانگین هر نفر در هر روز ثبت‌شده', val:days.length? fmtMoney(avgPP)+' تومان':'—', sub:days.length? 'از میانگین '+fmtNum(days.length)+' روز':'بعد از اولین ثبت نمایش داده می‌شود'},
    {lbl:'روزهای ثبت‌شده', val:fmtNum(days.length), sub:'صبحانه: '+fmtNum(bDays.length)+' · ناهار: '+fmtNum(lDays.length)},
    {lbl:'مجموع نفرات (رفت‌وآمدهای غذایی)', val:fmtNum(att), sub:'نفر-روز در این ماه'},
    {lbl:'روزهای بیش از سقف', val:fmtNum(over), sub: over? 'نیاز به بازبینی هزینه':'همه در سقف مجاز', cls: over? 'bad':'good'}
  ];
  cards.forEach(function(c){
    var d = el('div','stat'+(c.cls?' '+c.cls:''));
    d.appendChild(el('div','lbl',c.lbl));
    d.appendChild(el('div','val',c.val));
    d.appendChild(el('div','sub',c.sub));
    statsEl.appendChild(d);
  });

  var recent = document.getElementById('dashRecent');
  recent.innerHTML='';
  var sorted = recs.slice().sort(function(a,b){ return a.date<b.date?1:-1; }).slice(0,5);
  if(!sorted.length){
    var em = el('div','empty');
    em.appendChild(el('div','big','🍽'));
    em.appendChild(el('p',null,'هنوز هزینه‌ای برای این ماه ثبت نشده است.'));
    em.appendChild(el('p','small muted','از بخش «ثبت روزانه» اولین هزینه صبحانه یا ناهار را اضافه کنید.'));
    recent.appendChild(em);
  }else{
    sorted.forEach(function(r){ recent.appendChild(recordRow(r, false)); });
  }
}
dashMonthInput.addEventListener('change', function(){
  var v = parseMonthStr(dashMonthInput.value);
  if(v){ dashMonthInput.value = toFaDigits(v); renderDashboard(); }
  else if(dashMonthInput.value.trim()) toast('قالب ماه درست نیست؛ مثال: ۱۴۰۵/۰۷','bad');
});

/* ---------- ردیف ثبت (مشترک) ---------- */
function recordRow(r, withActions){
  var row = el('div','rec');
  var dt = el('div','rec-date');
  dt.appendChild(el('strong',null, fullDateLabel(r.date)));
  var mt = el('span','meal-tag '+r.meal, MEALS[r.meal].name);
  dt.appendChild(mt);
  row.appendChild(dt);

  var n1 = el('div','rec-num');
  n1.appendChild(el('small',null,'نفرات'));
  n1.appendChild(el('strong',null,fmtNum(r.attendees)+' نفر'));
  row.appendChild(n1);

  var n2 = el('div','rec-num');
  n2.appendChild(el('small',null,'کل هزینه'));
  n2.appendChild(el('strong',null,fmtMoney(r.totalCost)+' تومان'));
  row.appendChild(n2);

  var cap = state.budgets[r.meal];
  var pp = perPerson(r);
  var n3 = el('div','rec-num');
  n3.appendChild(el('small',null,'هر نفر / سقف'));
  n3.appendChild(el('strong',null,fmtMoney(pp)+' / '+fmtMoney(cap)));
  row.appendChild(n3);

  var st = capStatus(r);
  row.appendChild(el('span','tag '+st, st==='ok' ? 'زیر سقف ✓' : 'بیش از سقف!'));

  if(withActions){
    var act = el('div','rec-actions');
    var eb = el('button','btn btn-ghost btn-sm','ویرایش');
    eb.type='button';
    eb.addEventListener('click', function(){ openEditor(r.date, r.meal); });
    var db = el('button','btn btn-ghost btn-sm','حذف');
    db.type='button';
    db.addEventListener('click', function(){
      confirmDialog('حذف ثبت','ثبت '+MEALS[r.meal].name+' تاریخ '+fullDateLabel(r.date)+' حذف شود؟ این کار قابل بازگشت نیست.', function(){
        state.records = state.records.filter(function(x){ return !(x.date===r.date && x.meal===r.meal); });
        saveState(); renderRecords(); renderDashboard();
        toast('ثبت حذف شد.','ok');
      },'حذف');
    });
    act.appendChild(eb); act.appendChild(db);
    row.appendChild(act);
  }
  return row;
}

/* ---------- ویزارد ثبت ---------- */
var wf = {
  step: 1, date:null, meal:null, attendees:null
};
var mealFilterCache = null;
function setStep(n){
  wf.step = n;
  document.querySelectorAll('#wfSteps li').forEach(function(li){
    var s = li.getAttribute('data-step');
    li.classList.remove('is-active','is-done');
    if(s===String(n)) li.classList.add('is-active');
    else if(Number(s)<Number(n)) li.classList.add('is-done');
  });
  document.querySelectorAll('#view-workflow .wizard-step').forEach(function(d){
    d.classList.toggle('is-active', d.getAttribute('data-step')===String(n));
  });
  if(n===2){ document.getElementById('wfMealNote').textContent =
    'برای '+fullDateLabel(wf.date)+' فقط وعده‌های مجاز همان روز فعال هستند.'; refreshCaps(); }
  if(n===5) updateLiveStatus();
}
function refreshCaps(){
  document.querySelectorAll('[data-cap]').forEach(function(s){
    var k = s.getAttribute('data-cap');
    s.textContent = fmtMoney(state.budgets[k]);
  });
  var mealCards = document.querySelectorAll('.meal-card');
  mealCards.forEach(function(c){
    var k = c.getAttribute('data-meal');
    var ok = wf.date && mealAllowed(k, wf.date);
    c.disabled = !ok;
    c.style.opacity = ok? '1':'.42';
    c.title = ok? '': 'این روز ('+WEEK[weekdayIndex(wf.date)]+') برای این وعده پذیرایی نداریم';
  });
}
function showErr(id, msg){
  var e = document.getElementById(id);
  if(msg){ e.textContent = msg; e.hidden = false; } else e.hidden = true;
}
function wfSetDate(v, silent){
  showErr('wfDateError', null);
  var p = parseDateStr(v);
  if(!p){
    if(!silent) showErr('wfDateError','تاریخ نامعتبر است؛ قالب درست: YYYY/MM/DD (مثال: '+dateLabel((todayJ()||{str:'1405/07/29'}).str)+')');
    return false;
  }
  wf.date = p.jy+'/'+pad2(p.jm)+'/'+pad2(p.jd);
  document.getElementById('wfDate').value = toFaDigits(wf.date);
  document.getElementById('wfDateHint').textContent = 'روز هفته: '+WEEK[weekdayIndex(wf.date)]+
    ' — '+ (mealAllowed('breakfast',wf.date)?'صبحانه ✓ ':'صبحانه ✗ ')+(mealAllowed('lunch',wf.date)?'ناهار ✓':'ناهار ✗');
  var existingB = findRecord(wf.date,'breakfast'), existingL = findRecord(wf.date,'lunch');
  if(existingB||existingL){
    document.getElementById('wfModePill').textContent='به‌روزرسانی ثبت موجود';
    document.getElementById('wfModePill').className='pill warn';
  }else{
    document.getElementById('wfModePill').textContent='ثبت جدید';
    document.getElementById('wfModePill').className='pill';
  }
  return true;
}
document.getElementById('wfDateToday').addEventListener('click', function(){
  var t = todayJ();
  if(!t){ toast('تاریخ امروز در دسترس نیست.','bad'); return; }
  document.getElementById('wfDate').value = toFaDigits(t.str);
  wfSetDate(t.str);
});
document.getElementById('wfDate').addEventListener('change', function(){ wfSetDate(this.value); });

document.querySelectorAll('[data-next]').forEach(function(b){
  b.addEventListener('click', function(){ advance(Number(b.getAttribute('data-next'))); });
});
document.querySelectorAll('[data-back]').forEach(function(b){
  b.addEventListener('click', function(){ setStep(Number(b.getAttribute('data-back'))); });
});
function advance(n){
  if(n>=2){
    if(!wf.date){ if(!wfSetDate(document.getElementById('wfDate').value)) { showErr('wfDateError','ابتدا تاریخ معتبر را وارد کنید.'); return; } if(!wf.date) return; }
  }
  if(n>=3){
    if(!wf.meal){ showErr('wfMealError','یک وعده را انتخاب کنید.'); return; }
  }
  if(n>=4){
    var a = parseAmount(document.getElementById('wfAttendees').value);
    if(!(a>0) || Math.floor(a)!==a){ showErr('wfAttendeesError','تعداد نفرات را با یک عدد صحیح بزرگ‌تر از صفر وارد کنید.'); return; }
    showErr('wfAttendeesError',null);
    wf.attendees = a;
    renderSuggestion();
  }
  setStep(n);
}
document.querySelectorAll('.meal-card').forEach(function(c){
  c.addEventListener('click', function(){
    if(c.disabled) return;
    document.querySelectorAll('.meal-card').forEach(function(x){ x.setAttribute('aria-checked','false'); });
    c.setAttribute('aria-checked','true');
    wf.meal = c.getAttribute('data-meal');
    showErr('wfMealError',null);
  });
});
document.getElementById('attPlus').addEventListener('click', function(){
  var v = parseAmount(document.getElementById('wfAttendees').value)||0;
  document.getElementById('wfAttendees').value = toFaDigits(String(Math.min(999, v+1)));
});
document.getElementById('attMinus').addEventListener('click', function(){
  var v = parseAmount(document.getElementById('wfAttendees').value)||0;
  document.getElementById('wfAttendees').value = toFaDigits(String(Math.max(1, v-1)));
});

function renderSuggestion(){
  var box = document.getElementById('wfSuggestion');
  box.innerHTML='';
  var ctx = weeklySuggestion(wf.meal, wf.date, wf.attendees);
  var cap = ctx.cap;
  var cls = ctx.reason==='over'?'bad':(ctx.reason==='atCap'?'warn':'');
  var s = el('div','suggestion'+(cls?' '+cls:''));

  if(ctx.reason==='noPrior'){
    s.appendChild(el('p',null,'هیچ ثبت قبلی‌ای برای '+ctx.meal+' در این هفته قبل از این تاریخ وجود ندارد.'));
    var p1 = el('p'); var b1 = el('span','big', fmtMoney(cap)+' تومان');
    p1.appendChild(document.createTextNode('پیشنهاد برای هر نفر: ')); p1.appendChild(b1);
    s.appendChild(p1);
    s.appendChild(el('p',null,'مجموع پیشنهادی برای '+fmtNum(ctx.attendees)+' نفر امروز: '+fmtMoney(ctx.total)+' تومان'));
    s.appendChild(el('div','note','چون سابقه‌ای در این هفته نیست، همان سقف روزانه مجاز ('+fmtMoney(cap)+' تومان برای هر نفر) پیشنهاد می‌شود.'));
  } else if(ctx.reason==='over'){
    s.appendChild(el('p',null,'هشدار: میانگین روزهای ثبت‌شدهٔ قبلی این هفته از سقف بیشتر شده است.'));
    s.appendChild(el('p',null,'میانگین هر نفر در روزهای قبلی: '+fmtMoney(ctx.priorAvg)+' تومان — بیش از سقف '+fmtMoney(cap)+' تومان'));
    var p2 = el('p'); p2.appendChild(el('span','big','۰ تومان'));
    s.appendChild(p2);
    s.appendChild(el('div','note','هدف هفتگی از قبل شکسته شده است؛ با هیچ مبلغی نمی‌توان میانگین زیر سقف را به دست آورد. برای کم‌کردن شکاف، پیشنهاد امروز ۰ تومان است و بهتر است این وعده را حذف یا بسیار سبک برگزار کنید.'));
  } else {
    var head = el('p');
    head.appendChild(document.createTextNode('پیشنهاد برای هر نفر امروز: '));
    head.appendChild(el('span','big', fmtMoney(ctx.perPerson)+' تومان'));
    s.appendChild(head);
    s.appendChild(el('p',null,'مجموع پیشنهادی برای '+fmtNum(ctx.attendees)+' نفر امروز: '+fmtMoney(ctx.total)+' تومان'));
    var ul = el('ul');
    ul.appendChild(el('li',null,'میانگین هر نفر در '+fmtNum(ctx.priorCount)+' روز قبلیِ ثبت‌شدهٔ این هفته: '+fmtMoney(ctx.priorAvg)+' تومان'));
    ul.appendChild(el('li',null,'روزهای باقی‌ماندهٔ مجاز این هفته از امروز (شامل امروز): '+fmtNum(ctx.remaining)+' روز'));
    ul.appendChild(el('li',null,'سقف روزانه: '+fmtMoney(cap)+' تومان برای هر نفر'));
    s.appendChild(ul);
    if(ctx.reason==='atCap'){
      s.appendChild(el('div','note','بر اساس هزینه‌های قبلی، رسیدن به میانگین سقف نیاز به بیشتر از خودِ سقف داشت؛ چون سقف روزانه حداکثر مجاز است، پیشنهاد روی همان سقف ثابت شده است.'));
    }
    s.appendChild(el('div','note','نکته: روزهایی که ثبت نشده‌اند صفر فرض نمی‌شوند؛ فقط روزهای واقعاً ثبت‌شده در میانگین وارد می‌شوند و مابقی روزهای مجاز هفته تا پایان هفته در محاسبه لحاظ شده‌اند. اگر همین رکورد امروز را بعداً ویرایش کنید، محاسبه خودش را به‌روز می‌کند.'));
  }
  var rec = findRecord(wf.date, wf.meal);
  if(rec){
    var ex = el('div','insight warn','برای این تاریخ و این وعده قبلاً ثبت شده است (کل '+fmtMoney(rec.totalCost)+' تومان، '+fmtNum(rec.attendees)+' نفر). با ذخیره، همان ثبت به‌روزرسانی می‌شود و رکورد تکراری ساخته نمی‌شود.');
    box.appendChild(ex);
  }
  box.appendChild(s);
}
function updateLiveStatus(){
  var box = document.getElementById('wfLiveStatus');
  var a = parseAmount(document.getElementById('wfTotal').value);
  showErr('wfTotalError',null);
  if(!(a>=0)){ box.hidden = true; return; }
  if(!wf.date || !wf.meal || !wf.attendees){ box.hidden=true; return; }
  var cap = state.budgets[wf.meal];
  var pp = a/wf.attendees;
  box.hidden = false;
  if(pp > cap+0.5){
    box.className='live-status over';
    box.textContent = 'توجه: هزینه هر نفر ('+fmtMoney(pp)+' تومان) از سقف '+fmtMoney(cap)+' تومان بیشتر است. ثبت ممکن است، ولی بالای سقف علامت‌گذاری می‌شود.';
  }else{
    box.className='live-status ok';
    box.textContent = 'هزینه هر نفر: '+fmtMoney(pp)+' تومان — زیر سقف '+fmtMoney(cap)+' تومان ✓';
  }
  document.getElementById('wfActualNote').textContent =
    'پیشنهاد امروز: '+fmtMoney(Math.round(weeklySuggestion(wf.meal,wf.date,wf.attendees).perPerson))+' تومان برای هر نفر';
}
document.getElementById('wfTotal').addEventListener('input', updateLiveStatus);

document.getElementById('wfSave').addEventListener('click', function(){
  var a = parseAmount(document.getElementById('wfTotal').value);
  if(!(a>=0) || document.getElementById('wfTotal').value.trim()===''){
    showErr('wfTotalError','مبلغ واقعی کل هزینه را به تومان وارد کنید (عدد بزرگ‌تر یا مساوی صفر).'); return;
  }
  showErr('wfTotalError',null);
  if(!wf.date || !wf.meal || !wf.attendees){ toast('مراحل ثبت کامل نیست.','bad'); return; }
  var cap = state.budgets[wf.meal];
  var over = a/wf.attendees > cap+0.5;
  var save = function(){
    var now = new Date().toISOString();
    var rec = findRecord(wf.date, wf.meal);
    if(rec){
      rec.attendees = wf.attendees; rec.totalCost = a; rec.updatedAt = now;
    }else{
      rec = { date:wf.date, meal:wf.meal, attendees:wf.attendees, totalCost:a, createdAt:now, updatedAt:now };
      state.records.push(rec);
    }
    saveState();
    document.getElementById('wfSuccessTitle').textContent = over? 'ثبت شد (بالای سقف)' : 'ثبت شد';
    document.getElementById('wfSuccessText').textContent =
      MEALS[wf.meal].name+' '+fullDateLabel(wf.date)+' — '+fmtNum(wf.attendees)+' نفر، کل '+fmtMoney(a)+' تومان، هر نفر '+fmtMoney(a/wf.attendees)+' تومان'+
      (over? ' — بالاتر از سقف '+fmtMoney(cap)+' تومان':'')+'.';
    setStep('success');
    toast('ثبت با موفقیت ذخیره شد.','ok');
    renderDashboard();
  };
  if(over){
    confirmDialog('هزینه بالای سقف','هزینه هر نفر ('+fmtMoney(a/wf.attendees)+' تومان) از سقف روزانه ('+fmtMoney(cap)+' تومان) بیشتر است. ثبت شود؟', save, 'ثبت کن');
  }else save();
});
document.getElementById('wfNew').addEventListener('click', function(){ resetWizard(); goto('workflow'); });
function resetWizard(){
  wf = { step:1, date:null, meal:null, attendees:null };
  document.getElementById('wfDate').value='';
  document.getElementById('wfAttendees').value='';
  document.getElementById('wfTotal').value='';
  document.querySelectorAll('.meal-card').forEach(function(x){ x.setAttribute('aria-checked','false'); });
  showErr('wfDateError',null); showErr('wfMealError',null); showErr('wfAttendeesError',null); showErr('wfTotalError',null);
  document.getElementById('wfLiveStatus').hidden = true;
  document.getElementById('wfDateHint').textContent = 'روز هفته به‌صورت خودکار محاسبه می‌شود.';
  setStep(1);
}
function openEditor(dateStr, mealKey){
  goto('workflow');
  resetWizard();
  wfSetDate(dateStr, true);
  document.getElementById('wfDate').value = toFaDigits(dateStr);
  wf.meal = mealKey;
  document.querySelectorAll('.meal-card').forEach(function(x){
    x.setAttribute('aria-checked', String(x.getAttribute('data-meal')===mealKey));
  });
  var rec = findRecord(dateStr, mealKey);
  document.getElementById('wfAttendees').value = toFaDigits(String(rec? rec.attendees : ''));
  document.getElementById('wfTotal').value = rec? toFaDigits(String(rec.totalCost)) : '';
  wf.attendees = rec? rec.attendees : null;
  refreshCaps();
  renderSuggestion();
  setStep(5);
}

/* ---------- لیست هزینه‌ها ---------- */
var recMealFilter = 'all';
var recMonthInput = document.getElementById('recMonth');
var recAllMonths = document.getElementById('recAllMonths');
document.querySelectorAll('.tab').forEach(function(t){
  t.addEventListener('click', function(){
    document.querySelectorAll('.tab').forEach(function(x){ x.classList.remove('is-active'); x.setAttribute('aria-selected','false'); });
    t.classList.add('is-active'); t.setAttribute('aria-selected','true');
    recMealFilter = t.getAttribute('data-meal-filter');
    renderRecords();
  });
});
recAllMonths.addEventListener('change', renderRecords);
recMonthInput.addEventListener('change', function(){
  var v = parseMonthStr(recMonthInput.value);
  if(v){ recMonthInput.value = toFaDigits(v); renderRecords(); }
  else if(recMonthInput.value.trim()) toast('قالب ماه درست نیست؛ مثال: ۱۴۰۵/۰۷','bad');
});
function renderRecords(){
  var list = document.getElementById('recList');
  list.innerHTML='';
  var ym = recAllMonths.checked? null : parseMonthStr(recMonthInput.value);
  if(recMonthInput.value.trim() && !ym && !recAllMonths.checked){
    list.appendChild(el('p','error','قالب ماه نامعتبر است؛ مثال: ۱۴۰۵/۰۷'));
    return;
  }
  var recs = state.records.filter(function(r){
    if(recMealFilter!=='all' && r.meal!==recMealFilter) return false;
    if(ym && r.date.slice(0,7)!==ym) return false;
    return true;
  }).sort(function(a,b){ return a.date<b.date?1:(a.date>b.date?-1:(a.meal>b.meal?1:-1)); });

  var summary = document.getElementById('recSummary');
  summary.innerHTML='';
  var mkStat = function(lbl,val){
    var d = el('div','stat'); d.appendChild(el('div','lbl',lbl)); d.appendChild(el('div','val',val)); return d;
  };
  if(recs.length){
    var tot = recs.reduce(function(a,r){return a+r.totalCost;},0);
    var att = recs.reduce(function(a,r){return a+r.attendees;},0);
    summary.appendChild(mkStat('تعداد ثبت', fmtNum(recs.length)+' مورد'));
    summary.appendChild(mkStat('مجموع هزینه', fmtMoney(tot)+' تومان'));
    summary.appendChild(mkStat('مجموع نفرات', fmtNum(att)+' نفر'));
    summary.appendChild(mkStat('هزینه هر نفر-روز', fmtMoney(att? tot/att : 0)+' تومان'));
  }
  if(!recs.length){
    var em = el('div','empty');
    em.appendChild(el('div','big','📋'));
    em.appendChild(el('p',null, recMealFilter==='all'? 'هنوز هزینه‌ای ثبت نشده است. از «ثبت روزانه» شروع کنید!' :
      (recMealFilter==='breakfast'? 'هنوز هیچ صبحانه‌ای ثبت نشده است.' : 'هنوز هیچ ناهاری ثبت نشده است.')));
    em.appendChild(el('p','small muted','با فیلتر ماه یا وعده، لیست را محدود کنید یا ثبت جدیدی اضافه کنید.'));
    list.appendChild(em);
    return;
  }
  recs.forEach(function(r){ list.appendChild(recordRow(r, true)); });
}
document.getElementById('recExport').addEventListener('click', function(){
  var ym = recAllMonths.checked? null : parseMonthStr(recMonthInput.value);
  var recs = state.records.filter(function(r){
    if(recMealFilter!=='all' && r.meal!==recMealFilter) return false;
    if(ym && r.date.slice(0,7)!==ym) return false;
    return true;
  });
  exportCsv(recs, 'maoud-records.csv');
});

/* ---------- گزارش ماهانه ---------- */
var repMonthInput = document.getElementById('repMonth');
repMonthInput.addEventListener('change', function(){
  var v = parseMonthStr(repMonthInput.value);
  if(v){ repMonthInput.value = toFaDigits(v); renderReport(); }
  else if(repMonthInput.value.trim()) toast('قالب ماه درست نیست؛ مثال: ۱۴۰۵/۰۷','bad');
});
function renderReport(){
  var body = document.getElementById('repBody');
  body.innerHTML='';
  var ym = parseMonthStr(repMonthInput.value) || currentMonth();
  repMonthInput.value = toFaDigits(ym);
  document.getElementById('repMonthName').textContent = monthLabel(ym);
  var recs = recordsForMonth(ym,null);
  if(!recs.length){
    var em = el('div','empty');
    em.appendChild(el('div','big','📊'));
    em.appendChild(el('p',null,'برای '+monthLabel(ym)+' هنوز داده‌ای ثبت نشده است.'));
    em.appendChild(el('p','small muted','بعد از ثبت هزینه در «ثبت روزانه»، این گزارش به‌صورت خودکار پر می‌شود.'));
    body.appendChild(em);
    return;
  }
  var mkMeal = function(mealKey){
    var rs = recs.filter(function(r){return r.meal===mealKey;});
    var cap = state.budgets[mealKey];
    var box = el('div','card');
    box.appendChild(el('h3',null, MEALS[mealKey].name));
    if(!rs.length){ box.appendChild(el('p','muted small','در این ماه '+MEALS[mealKey].name+' ثبت نشده است.')); return box; }
    var cost = rs.reduce(function(a,r){return a+r.totalCost;},0);
    var att = rs.reduce(function(a,r){return a+r.attendees;},0);
    var avgDaily = rs.reduce(function(a,r){return a+perPerson(r);},0)/rs.length;
    var weighted = att? cost/att : 0;
    var overDays = rs.filter(function(r){return capStatus(r)==='bad';});
    var best = rs.slice().sort(function(a,b){ return perPerson(a)-perPerson(b); })[0];
    var ul = el('ul');
    var li = function(t){ ul.appendChild(el('li',null,t)); };
    li('تعداد روزهای ثبت‌شده: '+fmtNum(rs.length));
    li('مجموع هزینه: '+fmtMoney(cost)+' تومان');
    li('مجموع نفرات: '+fmtNum(att)+' نفر');
    li('میانگین روزانه سرِ نفر (میانگین حسابی روزها): '+fmtMoney(avgDaily)+' تومان — سقف: '+fmtMoney(cap)+' تومان '+(avgDaily>cap+0.5?'(بیش از سقف!)':'(زیر سقف ✓)'));
    li('هزینه وزنی هر نفر (مجموع هزینه ÷ مجموع نفرات): '+fmtMoney(weighted)+' تومان');
    li('روزهای بیش از سقف: '+fmtNum(overDays.length)+' روز');
    li('کم‌هزینه‌ترین روز: '+fullDateLabel(best.date)+' با '+fmtMoney(perPerson(best))+' تومان برای هر نفر');
    box.appendChild(ul);

    var bt = el('div','bar-row');
    bt.appendChild(el('div','bar-lbl'));
    var lbl = bt.querySelector('.bar-lbl');
    lbl.appendChild(el('span',null,'میانگین روزانه سرِ نفر در برابر سقف'));
    lbl.appendChild(el('span',null,fmtMoney(avgDaily)+' / '+fmtMoney(cap)));
    var track = el('div','bar-track');
    var fill = el('div','bar-fill'+(avgDaily>cap+0.5?' over':''));
    var pct = cap>0? Math.min(100, avgDaily/cap*100) : 100;
    requestAnimationFrame(function(){ fill.style.width = pct+'%'; });
    track.appendChild(fill);
    bt.appendChild(track);
    box.appendChild(bt);

    var chips = el('div','chips');
    var dt = el('div','dots');
    rs.slice().sort(function(a,b){return a.date<b.date?-1:1;}).forEach(function(r){
      var st = capStatus(r);
      dt.appendChild(el('span','dot-day '+st, dateLabel(r.date).slice(5)+''));
    });
    var legend = el('p','hint','سبز: زیر سقف — قرمز: بیش از سقف (هر خانه یک روز ثبت‌شده با روز/ماه)');
    box.appendChild(dt); box.appendChild(legend);
    return box;
  };
  var split = el('div','split');
  split.appendChild(mkMeal('breakfast'));
  split.appendChild(mkMeal('lunch'));
  body.appendChild(split);

  var days = dayStatsForMonth(ym);
  var insight = el('div','insight',
    'در '+monthLabel(ym)+'، '+fmtNum(days.length)+' روز ثبت شده و میانگین حسابی هزینه سرِ نفر در روزهای ثبت‌شده '+
    fmtMoney(days.reduce(function(a,d){return a+d.perPerson;},0)/days.length)+' تومان است. این گزارش فقط بر اساس ثبت‌های واردشده در همین مرورگر است.');
  body.appendChild(insight);
}

/* ---------- تنظیمات ---------- */
function renderSettings(){
  document.getElementById('setLunch').value = toFaDigits(String(state.budgets.lunch));
  document.getElementById('setBreakfast').value = toFaDigits(String(state.budgets.breakfast));
  refreshCaps();
}
document.getElementById('settingsForm').addEventListener('submit', function(e){
  e.preventDefault();
  var l = parseAmount(document.getElementById('setLunch').value);
  var b = parseAmount(document.getElementById('setBreakfast').value);
  var err = document.getElementById('setError');
  var bad = [];
  if(!(l>0) || Math.floor(l)!==l) bad.push('سقف ناهار');
  if(!(b>0) || Math.floor(b)!==b) bad.push('سقف صبحانه');
  if(bad.length){ err.textContent='برای '+bad.join(' و ')+' یک عدد صحیح مثبت (تومان) وارد کنید.'; err.hidden=false; return; }
  err.hidden = true;
  state.budgets.lunch = l; state.budgets.breakfast = b;
  saveState();
  refreshCaps(); renderDashboard();
  toast('تنظیمات ذخیره شد.','ok');
});
document.getElementById('setDefaults').addEventListener('click', function(){
  state.budgets.lunch = DEFAULTS.budgets.lunch;
  state.budgets.breakfast = DEFAULTS.budgets.breakfast;
  saveState(); renderSettings(); refreshCaps();
  toast('پیش‌فرض‌ها بازگردانده شد (ناهار ۲۸۰٬۰۰۰ / صبحانه ۱۰۰٬۰۰۰ تومان).','ok');
});

/* ---------- پشتیبان / بازیابی / CSV ---------- */
function download(filename, content, mime){
  var blob = new Blob([content], {type: mime||'application/octet-stream'});
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click();
  setTimeout(function(){ a.remove(); URL.revokeObjectURL(url); }, 400);
}
document.getElementById('exportJson').addEventListener('click', function(){
  var payload = { app:'maoud-food-panel', version:1, exportedAt:new Date().toISOString(), budgets:state.budgets, records:state.records };
  download('maoud-backup-'+(todayJ()? todayJ().str.replace(/\//g,'-'):'data')+'.json', JSON.stringify(payload,null,2), 'application/json');
  toast('فایل پشتیبان دانلود شد.','ok');
});
document.getElementById('importFile').addEventListener('change', function(e){
  var f = e.target.files && e.target.files[0];
  if(!f) return;
  var status = document.getElementById('importStatus');
  var reader = new FileReader();
  reader.onload = function(){
    try{
      var data = JSON.parse(reader.result);
      var recs = Array.isArray(data.records)? data.records : (Array.isArray(data)? data : null);
      if(!recs) throw new Error('ساختار فایل درست نیست');
      var good = recs.filter(validRecord);
      if(!good.length) throw new Error('هیچ ثبت معتبری در فایل پیدا نشد');
      status.textContent = 'فایل معتبر است: '+fmtNum(good.length)+' ثبت معتبر و بودجه‌ها خوانده شد.';
      confirmDialog('بازیابی پشتیبان','چه می‌خواهید انجام شود؟ «ادغام» ثبت‌های فایل را با داده‌های فعلی ترکیب می‌کند؛ «جایگزینی» همه داده‌های فعلی را پاک و فایل را جایگزین می‌کند.', function(){
        var budgets = data && data.budgets;
        state.records = good.map(function(r){
          var ex = state.records.find(function(x){return x.date===r.date&&x.meal===r.meal;});
          return ex? Object.assign({}, ex, r) : r;
        });
        if(budgets){
          var bl = parseAmount(budgets.lunch), bb = parseAmount(budgets.breakfast);
          if(bl>0) state.budgets.lunch = Math.floor(bl);
          if(bb>0) state.budgets.breakfast = Math.floor(bb);
        }
        // حذف تکراری‌ها (همان تاریخ/وعده — آخرین نسخه می‌ماند)
        var seen = {};
        state.records = state.records.filter(function(r){
          var k = r.date+'|'+r.meal;
          if(seen[k]) return false; seen[k]=true; return true;
        });
        saveState(); renderSettings(); renderDashboard(); renderRecords(); renderReport();
        status.textContent = 'بازیابی انجام شد.';
        toast('داده‌ها بازیابی شد.','ok');
      }, 'ادغام');
    }catch(err){
      status.textContent = 'خطا: '+(err && err.message ? err.message : 'فایل JSON نامعتبر است.');
      toast('بازیابی ناموفق بود.','bad');
    }
    e.target.value='';
  };
  reader.onerror = function(){ toast('خواندن فایل ناموفق بود.','bad'); };
  reader.readAsText(f, 'utf-8');
});
function csvCell(v){
  v = String(v==null?'':v);
  if(/[",\n]/.test(v)) v = '"'+v.replace(/"/g,'""')+'"';
  return v;
}
function exportCsv(recs, filename){
  if(!recs.length){ toast('رکوردی برای خروجی CSV نیست.','bad'); return; }
  var head = ['تاریخ','روز هفته','وعده','تعداد نفرات','کل هزینه (تومان)','هر نفر (تومان)','سقف (تومان)','وضعیت','ایجاد','به‌روزرسانی'];
  var lines = [head.join(',')];
  recs.slice().sort(function(a,b){return a.date<b.date?-1:1;}).forEach(function(r){
    var wi = weekdayIndex(r.date);
    lines.push([
      r.date, wi>=0?WEEK[wi]:'', r.meal, r.attendees, r.totalCost,
      Math.round(perPerson(r)), state.budgets[r.meal], capStatus(r)==='ok'?'زیر سقف':'بیش از سقف',
      r.createdAt||'', r.updatedAt||''
    ].map(csvCell).join(','));
  });
  download(filename, '\uFEFF'+lines.join('\r\n'), 'text/csv;charset=utf-8');
  toast('فایل CSV دانلود شد (با پشتیبانی فارسی در Excel).','ok');
}
document.getElementById('exportCsvAll').addEventListener('click', function(){
  exportCsv(state.records.slice(), 'maoud-records-all.csv');
});
document.getElementById('clearAll').addEventListener('click', function(){
  if(!state.records.length){ toast('داده‌ای برای پاک کردن نیست.','bad'); return; }
  confirmDialog('پاک کردن همه ثبت‌ها','همه '+fmtNum(state.records.length)+' ثبت در این مرورگر پاک می‌شود و قابل بازگشت نیست. مطمئن هستید؟', function(){
    state.records = [];
    saveState(); renderDashboard(); renderRecords(); renderReport();
    toast('همه ثبت‌ها پاک شد.','ok');
  }, 'پاک کن');
});

/* ---------- شروع ---------- */
function init(){
  refreshCaps();
  if(!jalaliOK){
    toast('مرورگر شما تقویم شمسی (Intl) را پشتیبانی نمی‌کند؛ لطفاً از Chrome، Firefox یا Edge جدید استفاده کنید.','bad');
  }
  var t = todayJ();
  var ym = t? t.str.slice(0,7) : '';
  dashMonthInput.value = toFaDigits(ym);
  recMonthInput.value = toFaDigits(ym);
  repMonthInput.value = toFaDigits(ym);
  document.getElementById('wfDate').value = t? toFaDigits(t.str) : '';
  if(t) wfSetDate(t.str, true);
  renderDashboard();
  goto('dashboard');
}
init();
