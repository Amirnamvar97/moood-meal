
/* ============================================================
   موعود — مدیریت هزینه صبحانه و ناهار | app.js  | سازنده: امیر
   ============================================================ */
'use strict';

/* ---------- ابزارهای عمومی ---------- */
const $  = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
const FA_DIGITS = '۰۱۲۳۴۵۶۷۸۹';
function faNum(x){ return String(x).replace(/[0-9]/g, d => FA_DIGITS[+d]); }
function toEnDigits(s){ return String(s).replace(/[۰-۹٠-٩]/g, c => {
  const i = '۰۱۲۳۴۵۶۷۸۹'.indexOf(c); return i >= 0 ? i : '٠١٢٣٤٥٦٧٨٩'.indexOf(c); }); }
function parseNum(s){
  const n = Number(toEnDigits(String(s)).replace(/[,\s٬،]/g, ''));
  return isFinite(n) ? n : NaN;
}
function fmtMoney(n){ return faNum(Math.round(n).toLocaleString('en-US')); }
function esc(s){ const d = document.createElement('div'); d.textContent = String(s == null ? '' : s); return d.innerHTML; }

/* ---------- تقویم شمسی (الگوریتم معتبر jalali_to_jd) ---------- */
function div(a, b){ return ~~(a / b); }
function jalCal(jy){
  const breaks = [-61,9,38,199,426,686,756,818,1111,1181,1210,1635,2060,2097,2192,2262,2324,2394,2456,3178];
  let bl = breaks.length, gy = jy + 621, leapJ = -14, jp = breaks[0], jm, jump = 0, n, i;
  if (jy < jp || jy >= breaks[bl - 1]) throw new Error('Jalali year out of range: ' + jy);
  for (i = 1; i < bl; i++){
    jm = breaks[i]; jump = jm - jp;
    if (jy < jm) break;
    leapJ = leapJ + div(jump, 33) * 8 + div(jump % 33, 4);
    jp = jm;
  }
  n = jy - jp;
  leapJ = leapJ + div(n, 33) * 8 + div((n % 33) + 3, 4);
  if ((jump % 33) === 4 && (jump - n) === 4) leapJ++;
  const leapG = div(gy, 4) - div((div(gy, 100) + 1) * 3, 4) - 150;
  const march = 20 + leapJ - leapG;
  if (jump - n < 6) n = n - jump + div(jump + 4, 33) * 33;
  let leap = (((n + 1) % 33) - 1) % 4;
  if (leap === -1) leap = 4;
  return { leap: leap, gy: gy, march: march };
}
function g2d(gy, gm, gd){
  let d = div((gy + div(gm - 8, 6) + 100100) * 1461, 4)
        + div(153 * ((gm + 9) % 12) + 2, 5) + gd - 34840408;
  d = d - div(div(gy + 100100 + div(gm - 8, 6), 100) * 3, 4) + 752;
  return d;
}
function d2g(jdn){
  let j = 4 * jdn + 139361631;
  j = j + div(div(4 * jdn + 183187720, 146097) * 3, 4) * 4 - 3908;
  const i = div((j % 1461) / 4, 1) * 5 + 308;
  const gd = div((i % 153) / 5, 1) + 1;
  const gm = ((div(i, 153) % 12) + 1) % 12;
  const gy = div(j, 1461) - 100100 + div(8 - gm, 6);
  return { gy: gy, gm: gm, gd: gd };
}
function j2d(jy, jm, jd){
  const r = jalCal(jy);
  return g2d(r.gy, 3, r.march) + (jm - 1) * 31 - div(jm, 7) * (jm - 7) + jd - 1;
}
function d2j(jdn){
  let gy = d2g(jdn).gy, jy = gy - 621, r = jalCal(jy), jdn1f = g2d(gy, 3, r.march), jd, jm, k;
  k = jdn - jdn1f;
  if (k >= 0){
    if (k <= 185){
      jm = 1 + div(k, 31); jd = (k % 31) + 1;
      return { jy: jy, jm: jm, jd: jd };
    } else k -= 186;
  } else {
    jy -= 1; k += 179;
    if (r.leap === 1) k += 1;
  }
  jm = 7 + div(k, 30); jd = (k % 30) + 1;
  return { jy: jy, jm: jm, jd: jd };
}
function jalaliMonthLen(jy, jm){
  if (jm <= 6) return 31;
  if (jm <= 11) return 30;
  return jalCal(jy).leap === 0 ? 30 : 29; // leap => اسفند 30 (leap==1 هم ممکن است در برخی الگوریتم‌ها)
}
function isLeapJalali(jy){ return jalCal(jy).leap === 0; }
function jalaliToDate(jy, jm, jd){
  const g = d2g(j2d(jy, jm, jd));
  return new Date(g.gy, g.gm - 1, g.gd);
}
function dateToJalali(d){
  return d2j(g2d(d.getFullYear(), d.getMonth() + 1, d.getDate()));
}
function todayJalali(){
  const n = new Date();
  return dateToJalali(new Date(n.getFullYear(), n.getMonth(), n.getDate()));
}
function jKey(j){ return j.jy + '-' + String(j.jm).padStart(2,'0') + '-' + String(j.jd).padStart(2,'0'); }
function keyToJ(key){ const a = key.split('-').map(Number); return { jy: a[0], jm: a[1], jd: a[2] }; }

const WEEK_DAYS = ['شنبه','یکشنبه','دوشنبه','سه‌شنبه','چهارشنبه','پنجشنبه','جمعه'];
// شاخص روز هفته ایرانی: شنبه=0 … جمعه=6
function jalaliWeekIndex(j){
  const d = jalaliToDate(j.jy, j.jm, j.jd);
  return (d.getDay() + 1) % 7;
}
const JMONTHS = ['فروردین','اردیبهشت','خرداد','تیر','مرداد','شهریور','مهر','آبان','آذر','دی','بهمن','اسفند'];
function fmtJ(j){ return faNum(j.jd) + ' ' + JMONTHS[j.jm - 1] + ' ' + faNum(j.jy); }
function fmtJFull(j){ return WEEK_DAYS[jalaliWeekIndex(j)] + ' ' + fmtJ(j); }

/* ---------- ثابت‌ها و وضعیت ---------- */
const MEALS = {
  lunch:     { name: 'ناهار',   short: 'ن', first: 0, last: 4 },  // شنبه تا چهارشنبه (0..4)
  breakfast: { name: 'صبحانه', short: 'ص', first: 0, last: 5 }   // شنبه تا پنجشنبه (0..5)
};
const WEEK_LEN = { lunch: 5, breakfast: 6 };
const DEFAULTS = { lunch: 280000, breakfast: 100000, smooth: 1 };
const LS_DATA = 'moeood.records.v1';
const LS_SET  = 'moeood.settings.v1';

function loadSettings(){
  let s = null;
  try { s = JSON.parse(localStorage.getItem(LS_SET) || 'null'); } catch(e){}
  return Object.assign({}, DEFAULTS, s || {});
}
function saveSettings(){ localStorage.setItem(LS_SET, JSON.stringify(state.settings)); }
function loadRecords(){
  let r = null;
  try { r = JSON.parse(localStorage.getItem(LS_DATA) || 'null'); } catch(e){}
  return Array.isArray(r) ? r : [];
}
function saveRecords(){ localStorage.setItem(LS_DATA, JSON.stringify(state.records)); }

const state = {
  settings: loadSettings(),
  records: loadRecords(),
  view: 'dashboard',
  entry: { step: 1, date: null, meal: null, people: null, editingId: null },
  jp: null,
  statsMonth: null,
  filter: { meal: 'all', month: 'all', search: '', sort: 'date-desc' }
};

function cap(m){ return Number(state.settings[m]) || DEFAULTS[m]; }
function uid(){ return 'r' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7); }
function findRecord(id){ return state.records.find(r => r.id === id); }

function recordFor(key, meal){ return state.records.find(r => r.key === key && r.meal === meal); }
function mealAllowed(meal, j){ const w = jalaliWeekIndex(j); return w >= MEALS[meal].first && w <= MEALS[meal].last; }

/* محاسبات رکورد */
function perPerson(r){ return r.people > 0 ? r.total / r.people : 0; }

/* میانگین هفتگی سقف‌دار برای پیشنهاد امروز */
function weekStartKey(j){
  const w = jalaliWeekIndex(j);
  const d = jalaliToDate(j.jy, j.jm, j.jd);
  d.setDate(d.getDate() - w);
  return keyToJ(jKey(dateToJalali(d)));
}
function addDaysJ(j, n){
  const d = jalaliToDate(j.jy, j.jm, j.jd);
  d.setDate(d.getDate() + n);
  return dateToJalali(d);
}
function suggestFor(j, meal, people){
  const st = weekStartKey(j);
  const wIdx = jalaliWeekIndex(j);
  const wkLen = WEEK_LEN[meal];
  const capD = cap(meal);
  const weeklyCap = capD * wkLen;
  const smooth = Number(state.settings.smooth) ? true : false;
  // میانگین سرانه ثبت‌شده‌های همان وعده در هفته جاری
  let used = 0, countedDays = 0, perList = [], pending = [];
  for (let i = 0; i < wIdx; i++){
    const day = addDaysJ(st, i);
    if (!mealAllowed(meal, day)) continue;
    const rec = recordFor(jKey(day), meal);
    if (rec){
      used += rec.total;
      countedDays++;
      if (rec.people > 0) perList.push(rec.total / rec.people);
    } else pending.push(day);
  }
  const avgPer = perList.length ? perList.reduce((a,b)=>a+b,0) / perList.length : capD;
  // روزهای ثبت‌نشدهٔ گذشته را با میانگین کش‌خورده تخمین می‌زنیم
  let est = 0;
  pending.forEach(() => {
    let p = avgPer;
    if (smooth){
      const f = 0.6 + 0.8 * Math.min(1, Math.max(0, 1 - pending.length / Math.max(1, wkLen)));
      p = Math.min(Math.max(avgPer * f, capD * 0.6), capD * 1.4);
    }
    est += p;
  });
  const spent = used + est;
  const remaining = Math.max(0, weeklyCap - spent);
  // بودجهٔ باقیمانده روی روزهای مجاز باقی‌مانده از امروز به بعد پخش می‌شود؛ پیشنهاد امروز = کل باقیمانده تقسیم بر نفرات
  const noDaysLeft = wIdx >= wkLen || !mealAllowed(meal, j);
  let per, target, over;
  if (people > 0){
    if (remaining <= 0){ per = 0; target = 0; over = true; }
    else {
      per = Math.min(Math.max(remaining / people, capD * 0.45), capD * 1.4);
      target = people * per;
      over = spent + target > weeklyCap + 1e-6;
    }
  } else {
    per = Math.max(0, remaining); // نمایش بودجهٔ قابل مصرف امروز (بدون تقسیم بر نفرات)
    target = per; over = spent > weeklyCap + 1e-6;
  }
  const doneDays = countedDays;
  return {
    per: per, target: target, remaining: remaining, spent: spent,
    weeklyCap: weeklyCap, capD: capD, over: over, doneDays: doneDays,
    pendingCount: pending.length, weekLen: wkLen, assumedPer: avgPer, noDaysLeft: noDaysLeft,
    assumed: pending.map(d => fmtJFull(d)).join('، ')
  };
}


/* ---------- رندر رنگ نسبت به سقف ---------- */
function perColor(per, meal){
  const ratio = per / cap(meal);
  if (ratio <= 1) return 'ok';
  if (ratio <= 1.15) return 'warn';
  return 'bad';
}
function badgeCls(cls){ return 'badge ' + (cls || ''); }
function byMealName(m){ return MEALS[m].name; }

/* ---------- سوابق ---------- */
function filteredRecords(){
  const f = state.filter;
  let list = state.records.slice();
  if (f.meal !== 'all') list = list.filter(r => r.meal === f.meal);
  if (f.month !== 'all') list = list.filter(r => r.jm === Number(f.month));
  if (f.search){
    const q = f.search.trim();
    list = list.filter(r => (r.note && r.note.includes(q)) || fmtJ(r).includes(q) || WEEK_DAYS[jalaliWeekIndex(r)].includes(q));
  }
  const cmp = {
    'date-desc': (a,b) => b.key.localeCompare(a.key),
    'date-asc':  (a,b) => a.key.localeCompare(b.key),
    'per-desc':  (a,b) => perPerson(b) - perPerson(a),
    'per-asc':   (a,b) => perPerson(a) - perPerson(b)
  };
  return list.sort(cmp[f.sort] || cmp['date-desc']);
}

function monthOptionsHTML(sel, includeAll){
  const yrs = new Set(state.records.map(r => r.jy));
  if (!yrs.size) yrs.add(todayJalali().jy);
  const months = [];
  yrs.forEach(y => { for (let m = 1; m <= 12; m++) months.push(y * 100 + m); });
  months.sort(function(a,b){ return b - a; });
  let html = includeAll ? '<option value="all">همهٔ ماه‌ها</option>' : '';
  months.forEach(v => {
    const y = Math.floor(v / 100), m = v % 100;
    html += '<option value="' + v + '">' + JMONTHS[m-1] + ' ' + faNum(y) + '</option>';
  });
  return html;
}

function viewList(){
  const box = $('#listTables'); if (!box) return;
  const sel = $('#fMonth');
  if (sel){
    const cur = sel.value;
    sel.innerHTML = monthOptionsHTML(sel, true);
    if (cur) sel.value = cur;
  }
  const f = state.filter;
  let list = state.records.slice();
  if (f.meal !== 'all') list = list.filter(r => r.meal === f.meal);
  if (f.month !== 'all') list = list.filter(r => (r.jy * 100 + r.jm) === Number(f.month));
  if (f.search){
    const q = f.search.trim();
    list = list.filter(r => (r.note && r.note.includes(q)) || fmtJ(r).includes(q) || WEEK_DAYS[jalaliWeekIndex(r)].includes(q));
  }
  if (f.sort === 'date-asc') list.sort((a,b) => a.key.localeCompare(b.key));
  else if (f.sort === 'per-desc') list.sort((a,b) => perPerson(b) - perPerson(a));
  else if (f.sort === 'per-asc') list.sort((a,b) => perPerson(a) - perPerson(b));
  else list.sort((a,b) => b.key.localeCompare(a.key));

  if (!list.length){
    box.innerHTML = '<div class="card"><p class="muted">با این فیلترها رکوردی یافت نشد.</p></div>';
    return;
  }
  const sum = { lunch: {t:0,p:0,n:0}, breakfast: {t:0,p:0,n:0} };
  list.forEach(r => { sum[r.meal].t += r.total; sum[r.meal].p += r.people; sum[r.meal].n++; });
  let html = '<div class="kpis">' +
    ['lunch','breakfast'].map(meal => {
      const s = sum[meal], per = s.p ? s.t / s.p : 0;
      return '<div class="kpi"><div class="kpi-label">' + byMealName(meal) + '</div><div class="kpi-value">' + fmtMoney(s.t) + ' <span class="unit">تومان</span></div>' +
        '<div class="kpi-sub">' + faNum(s.n) + ' رکورد · ' + faNum(s.p) + ' نفر-روز · سرانه ' + fmtMoney(per) + '</div></div>';
    }).join('') + '</div>';
  html += '<div class="card"><div class="tbl-wrap"><table class="tbl"><thead><tr><th>وعده</th><th>تاریخ</th><th>روز</th><th>نفرات</th><th>هزینه کل</th><th>هر نفر</th><th>وضعیت</th><th>توضیح</th><th></th></tr></thead><tbody>';
  list.forEach(r => {
    const pp = perPerson(r), cls = perColor(pp, r.meal);
    html += '<tr>' +
      '<td>' + MEALS[r.meal].short + ' ' + byMealName(r.meal) + '</td>' +
      '<td>' + fmtJ(r) + '</td>' +
      '<td>' + WEEK_DAYS[jalaliWeekIndex(r)] + '</td>' +
      '<td>' + faNum(r.people) + '</td>' +
      '<td>' + fmtMoney(r.total) + '</td>' +
      '<td class="num">' + fmtMoney(pp) + '</td>' +
      '<td><span class="' + badgeCls(cls) + '">' + (cls === 'ok' ? 'زیر سقف' : cls === 'warn' ? 'نزدیک سقف' : 'بیش از سقف') + '</span></td>' +
      '<td class="muted">' + esc(r.note || '') + '</td>' +
      '<td class="row-actions"><button class="btn btn-sm btn-ghost" data-edit="' + r.id + '">ویرایش</button>' +
      '<button class="btn btn-sm btn-danger" data-del="' + r.id + '">حذف</button></td></tr>';
  });
  html += '</tbody></table></div></div>';
  box.innerHTML = html;
}

/* ---------- آمار ماه ---------- */
function viewStats(){
  const boxK = $('#statsKpis'); if (!boxK) return;
  const sel = $('#statsMonth');
  if (sel){
    const cur = sel.value;
    sel.innerHTML = monthOptionsHTML(sel, false);
    if (state.statsMonth && String(state.statsMonth) !== cur) sel.value = String(state.statsMonth);
着自己的  }
  let jm;
  if (sel && sel.value){ const v = Number(sel.value); jm = v % 100; state.statsMonth = v; }
  else { const t0 = todayJalali(); jm = t0.jm; state.statsMonth = t0.jy * 100 + t0.jm; }
  const jy = Math.floor(state.statsMonth / 100);
  const list = state.records.filter(r => r.jm === jm && r.jy === jy);

  const kpis = { lunch: {t:0,p:0,d:0}, breakfast: {t:0,p:0,d:0} };
  const days = new Set();
  list.forEach(r => { kpis[r.meal].t += r.total; kpis[r.meal].p += r.people; kpis[r.meal].d++; days.add(r.key); });
  const mk = (label, val, sub) => '<div class="kpi"><div class="kpi-label">' + label + '</div><div class="kpi-value">' + val + '</div><div class="kpi-sub">' + sub + '</div></div>';
  const per = {
    lunch: kpis.lunch.p ? kpis.lunch.t / kpis.lunch.p : 0,
    breakfast: kpis.breakfast.p ? kpis.breakfast.t / kpis.breakfast.p : 0
  };
  const verdict = (p, m) => !kpis[m].p ? '—' : (p <= cap(m) ? 'کمتر از سقف ✓' : 'بیش از سقف به میزان ' + fmtMoney(p - cap(m)));
  boxK.innerHTML =
    mk('میانگین هر ناهار', fmtMoney(per.lunch) + ' <span class="unit">تومان</span>', 'سقف ' + fmtMoney(cap('lunch')) + ' — ' + verdict(per.lunch, 'lunch')) +
    mk('میانگین هر صبحانه', fmtMoney(per.breakfast) + ' <span class="unit">تومان</span>', 'سقف ' + fmtMoney(cap('breakfast')) + ' — ' + verdict(per.breakfast, 'breakfast')) +
    mk('کل هزینهٔ ماه', fmtMoney(kpis.lunch.t + kpis.breakfast.t) + ' <span class="unit">تومان</span>', 'ناهار ' + fmtMoney(kpis.lunch.t) + ' · صبحانه ' + fmtMoney(kpis.breakfast.t)) +
    mk('روزهای ثبت‌شده', faNum(days.size) + ' روز', 'ناهار ' + faNum(kpis.lunch.d) + ' رکورد · صبحانه ' + faNum(kpis.breakfast.d) + ' رکورد');

  const boxG = $('#gaugeBox');
  if (boxG) boxG.innerHTML = ['lunch','breakfast'].map(m => {
    const pct = per[m] ? Math.round(per[m] / cap(m) * 100) : 0;
    return '<div class="gauge-row"><span>' + byMealName(m) + '</span><div class="gauge"><div class="gauge-fill ' + perColor(per[m], m) + '" style="width:' + Math.min(100, pct) + '%"></div></div><strong>' + faNum(pct) + '٪ سقف</strong></div>';
  }).join('') + '<p class="note">نسبت میانگین سرانهٔ ماه به سقف روزانه؛ زیر ۱۰۰٪ یعنی در بودجه.</p>';

  const boxB = $('#mealBreakdown');
  if (boxB) boxB.innerHTML = ['lunch','breakfast'].map(m => {
    const k = kpis[m];
    return '<div class="break-row"><span class="tag tag-' + m + '">' + byMealName(m) + '</span>' +
      '<span>' + fmtMoney(k.t) + ' تومان</span><span>' + faNum(k.d) + ' روز</span>' +
      '<span>' + faNum(k.p) + ' نفر-روز</span><span>سرانه ' + fmtMoney(per[m]) + '</span></div>';
  }).join('');

  const boxC = $('#monthChart');
  if (boxC){
    const byDay = {};
    list.forEach(r => {
      const o = byDay[r.key] = byDay[r.key] || { lunch: 0, breakfast: 0 };
      o[r.meal] = Math.max(o[r.meal], perPerson(r));
    });
    const keys = Object.keys(byDay).sort();
    let svg;
    if (!keys.length){
      svg = '<p class="muted">این ماه رکوردی ثبت نشده است.</p>';
    } else {
      const allPer = [];
      keys.forEach(k => { if (byDay[k].lunch) allPer.push(byDay[k].lunch); if (byDay[k].breakfast) allPer.push(byDay[k].breakfast); });
      const maxY = Math.max(cap('lunch') * 1.15, Math.max.apply(null, allPer) * 1.15);
      const W = 640, H = 220, PL = 50, PR = 10, PT = 12, PB = 28, iw = W - PL - PR, ih = H - PB - PT;
      const yOf = v => PT + ih - (v / maxY) * ih;
      const xOf = i => keys.length > 1 ? PL + (i * iw / (keys.length - 1)) : PL + iw / 2;
      let s = '<svg viewBox="0 0 ' + W + ' ' + H + '" class="chart" preserveAspectRatio="xMidYMid meet">';
      [0, 0.5, 1].forEach(f => {
        const y = yOf(maxY * f);
        s += '<line x1="' + PL + '" y1="' + y + '" x2="' + (W - PR) + '" y2="' + y + '" class="ch-grid"/>' +
             '<text x="' + (PL - 6) + '" y="' + (y + 4) + '" text-anchor="end" class="ch-lbl">' + faNum(Math.round(maxY * f / 1000)) + 'هزار</text>';
      });
      s += '<line x1="' + PL + '" y1="' + yOf(cap('lunch')) + '" x2="' + (W - PR) + '" y2="' + yOf(cap('lunch')) + '" class="ch-cap lunch"/>' +
           '<line x1="' + PL + '" y1="' + yOf(cap('breakfast')) + '" x2="' + (W - PR) + '" y2="' + yOf(cap('breakfast')) + '" class="ch-cap breakfast"/>';
      ['lunch','breakfast'].forEach(m => {
        let d = '', started = false;
        keys.forEach((k, i) => {
          const v = byDay[k][m]; if (!v) return;
          d += (started ? ' L' : ' M') + xOf(i).toFixed(1) + ' ' + yOf(v).toFixed(1); started = true;
        });
        if (started) s += '<path d="' + d + '" class="ch-line ' + m + '"/>';
        keys.forEach((k, i) => {
          const v = byDay[k][m]; if (!v) return;
          s += '<circle cx="' + xOf(i).toFixed(1) + '" cy="' + yOf(v).toFixed(1) + '" r="3.2" class="ch-dot ' + m + '"/>';
        });
      });
      keys.forEach((k, i) => {
        s += '<text x="' + xOf(i) + '" y="' + (H - 8) + '" text-anchor="middle" class="ch-lbl">' + faNum(keyToJ(k).jd) + '</text>';
      });
      svg = s + '</svg>';
    }
    boxC.innerHTML = svg;
    const lg = $('#monthChartLegend');
    if (lg) lg.innerHTML = '<span class="lg-item"><i class="dot lunch"></i> ناهار</span><span class="lg-item"><i class="dot breakfast"></i> صبحانه</span><span class="lg-item"><i class="dot cap"></i> سقف روزانه</span>';
  }

  const boxI = $('#insights');
  if (boxI){
    const ins = [];
    if (list.length){
      if (per.lunch > cap('lunch')) ins.push('میانگین هر ناهار ' + fmtMoney(per.lunch - cap('lunch')) + ' تومان بیشتر از سقف است؛ برای عادی‌شدن، وعده‌های گران را با گزینه‌های ارزان‌تر جایگزین کنید.');
      if (per.breakfast > cap('breakfast')) ins.push('میانگین صبحانه از سقف گذشته است؛ سهم اقلام گران را کم کنید.');
      if (per.lunch && per.lunch < cap('lunch') * 0.85) ins.push('ناهار به‌طور میانگین ' + fmtMoney(cap('lunch') - per.lunch) + ' تومان زیر سقف است؛ می‌توانید کیفیت وعده را کمی بالا ببرید.');
      const best = list.slice().sort((a,b) => perPerson(a) - perPerson(b))[0];
      const worst = list.slice().sort((a,b) => perPerson(b) - perPerson(a))[0];
      if (best && worst && best.id !== worst.id){
        ins.push('کم‌هزینه‌ترین روز: ' + fmtJFull(best) + ' (' + byMealName(best.meal) + '، هر نفر ' + fmtMoney(perPerson(best)) + ')');
        ins.push('پرهزینه‌ترین روز: ' + fmtJFull(worst) + ' (' + byMealName(worst.meal) + '، هر نفر ' + fmtMoney(perPerson(worst)) + ')');
      }
      const overCount = list.filter(r => perPerson(r) > cap(r.meal)).length;
      if (overCount) ins.push(faNum(overCount) + ' رکورد از سقف روزانه عبور کرده است.');
    } else {
      ins.push('این ماه رکوردی ثبت نشده است.');
    }
    boxI.innerHTML = '<ul class="insights">' + ins.map(s => '<li>' + s + '</li>').join('') + '</ul>';
  }
}

/* ---------- ابزارهای نمودار کوچک داشبورد ---------- */
function buildMiniChart(recs){
  const meals = ['lunch','breakfast'];
  const W = 640, H = 200, PL = 50, PR = 8, PT = 10, PB = 24, iw = W - PL - PR, ih = H - PB - PT;
  let maxY = cap('lunch');
  recs.forEach(r => { maxY = Math.max(maxY, perPerson(r) * 1.15); });
  const xOf = i => recs.length > 1 ? PL + i * iw / (recs.length - 1) : PL + iw / 2;
  const yOf = v => PT + ih - (v / maxY) * ih;
  let s = '';
  [0, 0.5, 1].forEach(f => {
    const y = yOf(maxY * f);
    s += '<line x1="' + PL + '" y1="' + y + '" x2="' + (W - PR) + '" y2="' + y + '" class="ch-grid"/>' +
         '<text x="' + (PL - 6) + '" y="' + (y + 4) + '" text-anchor="end" class="ch-lbl">' + faNum(Math.round(maxY * f / 1000)) + 'هزار</text>';
  });
  s += '<line x1="' + PL + '" y1="' + yOf(cap('lunch')) + '" x2="' + (W - PR) + '" y2="' + yOf(cap('lunch')) + '" class="ch-cap lunch"/>';
  meals.forEach(m => {
    const pts = [];
    recs.forEach((r, i) => { if (r.meal === m) pts.push([xOf(i), yOf(perPerson(r))]); });
    if (pts.length > 1) s += '<path d="M' + pts.map(p => p[0].toFixed(1) + ' ' + p[1].toFixed(1)).join(' L') + '" class="ch-line ' + m + '"/>';
    pts.forEach(p => s += '<circle cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="3" class="ch-dot ' + m + '"/>');
  });
  const skip = Math.max(1, Math.ceil(recs.length / 7));
  recs.forEach((r, i) => {
    if (i % skip === 0) s += '<text x="' + xOf(i) + '" y="' + (H - 6) + '" text-anchor="middle" class="ch-lbl">' + faNum(r.jd) + '</text>';
  });
  return s;
}

function recentWeeks(n){
  const out = [];
  let start = weekStartKey(todayJalali());
  for (let i = 0; i < n; i++){
    const end = addDaysJ(start, 6);
    const recs = state.records.filter(r => r.key >= jKey(start) && r.key <= jKey(end));
    const agg = { lunch: {t:0,p:0}, breakfast: {t:0,p:0} };
    recs.forEach(r => { agg[r.meal].t += r.total; agg[r.meal].p += r.people; });
    out.push({ start: start, per: {
      lunch: agg.lunch.p ? agg.lunch.t / agg.lunch.p : 0,
      breakfast: agg.breakfast.p ? agg.breakfast.t / agg.breakfast.p : 0
    }});
    start = addDaysJ(start, -7);
  }
  out.reverse();
  return out;
}

/* ---------- داشبورد ---------- */
function viewDashboard(){
  const t = todayJalali();
  const wkStart = weekStartKey(t);
  const bT = $('#brandToday'); if (bT) bT.textContent = fmtJFull(t);
  const we = addDaysJ(wkStart, 5);
  $('#weekRangeLabel').textContent = JMONTHS[wkStart.jm-1] + ' ' + faNum(wkStart.jd) + ' تا ' + JMONTHS[we.jm-1] + ' ' + faNum(we.jd);
  $('#weekTodayBadge').textContent = 'امروز: ' + WEEK_DAYS[jalaliWeekIndex(t)];

  let rows = '';
  for (let i = 0; i < 6; i++){
    const day = addDaysJ(wkStart, i), k = jKey(day), w = jalaliWeekIndex(day);
    const isToday = k === jKey(t), isFuture = k > jKey(t);
    const cell = meal => {
      if (!mealAllowed(meal, day)) return '<td class="dim">—</td>';
      const r = recordFor(k, meal);
      return '<td><span class="' + badgeCls(r ? perColor(perPerson(r), meal) : 'dim') + '">' +
        (r ? fmtMoney(perPerson(r)) : (isFuture ? '—' : 'ثبت نشده')) + '</span></td>';
    };
    rows += '<tr class="' + (isToday ? 'row-today' : '') + '"><td>' + WEEK_DAYS[w] + (isToday ? ' (امروز)' : '') + '</td><td>' + fmtJ(day) + '</td>' + cell('lunch') + cell('breakfast') + '</tr>';
  }
  $('#weekTable').innerHTML = '<div class="tbl-wrap"><table class="tbl"><thead><tr><th>روز</th><th>تاریخ</th><th>ناهار (هر نفر)</th><th>صبحانه (هر نفر)</th></tr></thead><tbody>' + rows + '</tbody></table></div>';

  const sg = { lunch: suggestFor(t, 'lunch', 0), breakfast: suggestFor(t, 'breakfast', 0) };
  const sHtml = m => {
    if (!mealAllowed(m, t)) return '<p class="note">امروز ' + byMealName(m) + ' در برنامه نیست (فقط شنبه تا ' + (m === 'lunch' ? 'چهارشنبه' : 'پنجشنبه') + ').</p>';
    const s = sg[m];
    let html = '<div class="sugg"><div class="sugg-head">' + byMealName(m) + ' — سقف روزانه ' + fmtMoney(s.capD) + ' تومان</div>';
    if (s.noDaysLeft){
      html += '<p class="note">این هفته صفحه‌اش تمام شده؛ روز مجازی باقی نمانده.</p>';
    } else {
      html += '<div class="sugg-per">' + fmtMoney(s.per) + ' <span class="unit">تومان هر نفر</span></div>' +
        '<div class="sugg-note">برای رسیدن میانگین سرانهٔ این هفته به سقف هفتگی (' + fmtMoney(s.weeklyCap) + ' تومان برای ' + faNum(s.weekLen) + ' روز)، امروز می‌توانید در مجموع حدود ' + fmtMoney(s.target) + ' تومان هزینه کنید.</div>' +
        '<div class="sugg-note muted">ثبت‌شده: ' + fmtMoney(s.spent) + ' · باقیمانده: ' + fmtMoney(s.remaining) +
        (s.pendingCount ? ' · فرض: ' + faNum(s.pendingCount) + ' روز ثبت‌نشدهٔ گذشته با سرانهٔ حدودی ' + fmtMoney(s.assumedPer) : '') + '</div>';
      if (s.over) html += '<p class="note warn-note">⚠️ با این فرض‌ها بودجهٔ هفته برابر سقف کافی نیست؛ پیشنهاد به سقف روزانه محدود شده است.</p>';
    }
    return html + '</div>';
  };
  $('#todaySuggest').innerHTML = sHtml('lunch') + sHtml('breakfast');

  const jmT = t.jm;
  $('#monthLabel').textContent = JMONTHS[jmT - 1] + ' ' + faNum(t.jy);
  const list = state.records.filter(r => r.jm === jmT && r.jy === t.jy);
  const agg = { lunch: {t:0,p:0,n:0}, breakfast: {t:0,p:0,n:0} };
  list.forEach(r => { agg[r.meal].t += r.total; agg[r.meal].p += r.people; agg[r.meal].n++; });
  const mkpi = (label, val, sub) => '<div class="kpi"><div class="kpi-label">' + label + '</div><div class="kpi-value">' + val + '</div><div class="kpi-sub">' + sub + '</div></div>';
  const per = { lunch: agg.lunch.p ? agg.lunch.t / agg.lunch.p : 0, breakfast: agg.breakfast.p ? agg.breakfast.t / agg.breakfast.p : 0 };
  $('#monthKpis').innerHTML =
    mkpi('سرانهٔ ناهار این ماه', fmtMoney(per.lunch) + ' <span class="unit">تومان</span>', 'سقف ' + fmtMoney(cap('lunch')) + ' · ' + faNum(agg.lunch.n) + ' رکورد') +
    mkpi('سرانهٔ صبحانه این ماه', fmtMoney(per.breakfast) + ' <span class="unit">تومان</span>', 'سقف ' + fmtMoney(cap('breakfast')) + ' · ' + faNum(agg.breakfast.n) + ' رکورد') +
    mkpi('کل هزینهٔ ماه', fmtMoney(agg.lunch.t + agg.breakfast.t) + ' <span class="unit">تومان</span>', 'مجموع دو وعده') +
    mkpi('مجموع نفر-روز', faNum(agg.lunch.p + agg.breakfast.p) + ' نفر', 'تعداد کل نفرات ثبت‌شده');

  const recent = state.records.slice().sort((a,b) => b.key.localeCompare(a.key)).slice(0, 14).reverse();
  $('#trendChart').innerHTML = '<svg viewBox="0 0 640 200" class="chart" preserveAspectRatio="xMidYMid meet">' +
    (recent.length ? buildMiniChart(recent) : '<text x="320" y="100" text-anchor="middle" class="ch-lbl">داده‌ای برای نمایش نیست</text>') + '</svg>';

  const top = state.records.slice().sort((a,b) => (perPerson(b)/cap(b.meal)) - (perPerson(a)/cap(a.meal))).slice(0, 6);
  $('#topDays').innerHTML = top.length ? '<ul class="topdays">' + top.map(r =>
    '<li><span class="' + badgeCls(perColor(perPerson(r), r.meal)) + '">' + MEALS[r.meal].short + '</span> ' + fmtJFull(r) +
    ' — هر نفر <strong>' + fmtMoney(perPerson(r)) + '</strong> (' + faNum(Math.round(perPerson(r) / cap(r.meal) * 100)) + '٪ سقف)</li>').join('') + '</ul>'
    : '<p class="muted">هنوز داده‌ای نیست.</p>';

  const missing = ['lunch','breakfast'].filter(m => mealAllowed(m, t) && !recordFor(jKey(t), m));
  $('#todayMissing').innerHTML = missing.length ?
    '<ul class="insights">' + missing.map(m => '<li>' + byMealName(m) + ' امروز ثبت نشده. <button class="btn btn-sm btn-primary" data-missing="' + m + '">ثبت کن</button></li>').join('') + '</ul>'
    : '<p class="ok-note">✓ وعده‌های مجاز امروز ثبت شده‌اند.</p>';

  const weeks = recentWeeks(5);
  const wk = weeks.map((w, i) => {
    const lbl = (i === weeks.length - 1) ? 'این هفته' : fmtJ(w.start);
    const bar = (m) => {
      const pct = w.per[m] ? Math.min(100, Math.round(w.per[m] / cap(m) * 100)) : 0;
      return '<div class="wbar"><span>' + byMealName(m) + '</span><div class="gauge"><div class="gauge-fill ' + (pct > 100 ? 'bad' : pct >= 90 ? 'warn' : 'ok') + '" style="width:' + pct + '%"></div></div><strong>' + fmtMoney(w.per[m]) + '</strong></div>';
    };
    return '<div class="wrow"><div class="wrow-label">' + lbl + '</div>' + bar('lunch') + bar('breakfast') + '</div>';
  }).join('');
  $('#weeksChart').innerHTML = weeks.length ? wk : '<p class="muted">—</p>';
  const wn = $('#weekNote');
  if (wn) wn.textContent = 'اعداد جدول، هزینهٔ هر نفر در آن روز است. «ثبت نشده» یعنی رکوردی برای آن روزوجود ندارد.';
}


/* ---------- انتخاب‌گر شمسی ---------- */
function initPicker(){
  const t = todayJalali();
  state.jp = { jy: t.jy, jm: t.jm };
  state.entry.date = t;
  const wd = $('#jpWeekdays');
  if (wd) wd.innerHTML = ['ش','ی','د','س','چ','پ','ج'].map((x,i) => '<span' + (i===6 ? ' class="offday"' : '') + '>' + x + '</span>').join('');
  renderPicker();
}
function renderPicker(){
  if (!state.jp) return;
  const {jy,jm} = state.jp;
  $('#jpLabel').textContent = JMONTHS[jm-1] + ' ' + faNum(jy);
  const grid = $('#jpGrid');
  if (!grid) return;
  const first = jalaliWeekIndex({jy:jy,jm:jm,jd:1});
  const len = jalaliMonthLen(jy,jm);
  const t = todayJalali();
  const chosen = state.entry.date ? jKey(state.entry.date) : '';
  let html = '';
  for (let i=0; i<first; i++) html += '<span class="jp-empty"></span>';
  for (let d=1; d<=len; d++){
    const j = {jy:jy,jm:jm,jd:d}, k=jKey(j), w=jalaliWeekIndex(j);
    const off = w===6;
    const today = k===jKey(t), sel = k===chosen;
    const disabled = off;
    html += '<button type="button" class="jp-day' + (off?' offday':'') + (today?' today':'') + (sel?' selected':'') + '" data-date="' + k + '"' + (disabled?' disabled aria-disabled="true"':'') + '>' + faNum(d) + '</button>';
  }
  grid.innerHTML = html;
  const selected = $('#jpSelected');
  if (selected) selected.textContent = state.entry.date ? fmtJFull(state.entry.date) : '—';
  const note = $('#dateNote');
  if (note) note.textContent = 'فقط شنبه تا پنجشنبه قابل انتخاب است؛ جمعه غیرفعال است.';
}
function movePicker(offset){
  let jy=state.jp.jy, jm=state.jp.jm+offset;
  if (jm<1){jm=12;jy--;} if (jm>12){jm=1;jy++;}
  state.jp={jy:jy,jm:jm}; renderPicker();
}

/* ---------- فرم چهارمرحله‌ای ---------- */
function showStep(n){
  state.entry.step = Math.max(1,Math.min(4,n));
  $$('.step').forEach(el => { el.hidden = Number(el.dataset.step)!==state.entry.step; });
  $$('#stepper li').forEach(el => {
    const k=Number(el.dataset.step);
    el.classList.toggle('active', k===state.entry.step);
    el.classList.toggle('done', k<state.entry.step);
  });
  $('#btnBack').disabled = state.entry.step===1;
  $('#btnNext').textContent = state.entry.step===4 ? (state.entry.editingId ? 'ذخیره ویرایش' : 'ثبت هزینه') : 'بعدی';
  $('#entryError').hidden = true;
  updateEntryUI();
}
function setEntryDate(j){
  state.entry.date=j;
  state.jp={jy:j.jy,jm:j.jm};
  renderPicker();
  if (state.entry.meal && !mealAllowed(state.entry.meal,j)) state.entry.meal=null;
  updateEntryUI();
}
function setEntryMeal(meal){
  state.entry.meal=meal;
  $$('.meal-opt').forEach(b => b.classList.toggle('selected', b.dataset.meal===meal));
  updateEntryUI();
}
function setEntryPeople(v){
  state.entry.people=v;
  const inp=$('#inPeople');
  if (inp) inp.value = v ? faNum(v) : '';
  updateEntryUI();
}
function updateEntryUI(){
  const e=state.entry;
  $$('.meal-opt').forEach(b => {
    const m=b.dataset.meal;
    const allowed=e.date && mealAllowed(m,e.date);
    b.disabled=!allowed;
    b.classList.toggle('selected', e.meal===m);
    const meta=$('#mealMeta'+(m==='lunch'?'Lunch':'Breakfast'));
    if(meta) meta.textContent = 'سقف ' + fmtMoney(cap(m)) + ' تومان' + (allowed?'':' · امروز نیست');
  });
  const people=Number(e.people)||0;
  const hint=$('#peopleHint');
  if(hint){
    if(e.date && e.meal){
      const r=suggestFor(e.date,e.meal,people);
      hint.textContent = 'سقف روزانه هر نفر: ' + fmtMoney(cap(e.meal)) + ' تومان؛ پیشنهاد فعلی: ' + (people?fmtMoney(r.per)+' تومان برای هر نفر':'تعداد را وارد کنید تا پیشنهاد محاسبه شود.');
    } else hint.textContent='ابتدا تاریخ و وعده را انتخاب کنید.';
  }
  const sb=$('#suggestBox');
  if(sb){
    if(e.date && e.meal && people>0){
      const s=suggestFor(e.date,e.meal,people);
      sb.innerHTML='<div class="suggest-card"><strong>پیشنهاد سقف‌دار</strong><div>' + fmtMoney(s.per) + ' تومان برای هر نفر؛ مجموعاً حدود ' + fmtMoney(s.target) + ' تومان برای ' + faNum(people) + ' نفر</div><small>بودجهٔ هفتگی ' + fmtMoney(s.weeklyCap) + ' · خرج/تخمین روزهای گذشته ' + fmtMoney(s.spent) + (s.pendingCount?' · '+faNum(s.pendingCount)+' روز گذشته بر اساس میانگین تخمین زده شد':'') + '</small>'+(s.over?'<p class="warn-note">هشدار: بودجهٔ باقیمانده برای حفظ سقف هفتگی کافی نیست.</p>':'')+'</div>';
    } else sb.innerHTML='';
  }
  const pLive=$('#perPersonLive'), total=parseNum($('#inTotal')?.value||'');
  if(pLive){
    pLive.textContent=(total>=0 && people>0)?'سرانهٔ واقعی: '+fmtMoney(total/people)+' تومان برای هر نفر'+(e.meal?' · سقف '+fmtMoney(cap(e.meal)):''):' ';
  }
  const summary=$('#entrySummary');
  if(summary && e.date && e.meal){
    summary.innerHTML='<strong>خلاصه:</strong> '+fmtJFull(e.date)+' · '+byMealName(e.meal)+' · '+(people?faNum(people)+' نفر':'تعداد نامشخص')+' · سقف روزانه '+fmtMoney(cap(e.meal))+' تومان';
  }
  const banner=$('#editingBanner');
  if(banner){
    banner.hidden=!e.editingId;
    if(e.editingId) banner.textContent='در حال ویرایش رکورد؛ ذخیره، رکورد قبلی همین تاریخ و وعده را جایگزین می‌کند.';
  }
}
function clearEntry(){
  state.entry={step:1,date:todayJalali(),meal:null,people:null,editingId:null};
  state.jp={jy:state.entry.date.jy,jm:state.entry.date.jm};
  $('#inPeople').value=''; $('#inTotal').value=''; $('#inNote').value='';
  $('#btnCancelEdit').hidden=true;
  renderPicker(); showStep(1);
}
function entryError(msg){
  const el=$('#entryError'); el.textContent=msg; el.hidden=false;
  el.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function editRecord(id){
  const r=findRecord(id); if(!r)return;
  state.entry={step:1,date:{jy:r.jy,jm:r.jm,jd:r.jd},meal:r.meal,people:r.people,editingId:r.id};
  state.jp={jy:r.jy,jm:r.jm};
  $('#inPeople').value=faNum(r.people); $('#inTotal').value=faNum(r.total); $('#inNote').value=r.note||'';
  $('#btnCancelEdit').hidden=false;
  renderPicker(); setEntryMeal(r.meal); showStep(1); navigate('entry');
}
function submitEntry(){
  const e=state.entry;
  if(!e.date){entryError('تاریخ را انتخاب کنید.');showStep(1);return;}
  if(!e.meal){entryError('وعده را انتخاب کنید.');showStep(2);return;}
  const people=Number(e.people), total=parseNum($('#inTotal').value);
  if(!Number.isInteger(people)||people<1){entryError('تعداد نفرات باید عدد صحیح و حداقل ۱ باشد.');showStep(3);return;}
  if(!isFinite(total)||total<0){entryError('هزینه باید عددی معتبر و صفر یا بیشتر باشد.');return;}
  if(!mealAllowed(e.meal,e.date)){entryError('این وعده در روز انتخاب‌شده ارائه نمی‌شود.');showStep(2);return;}
  const key=jKey(e.date), old=recordFor(key,e.meal);
  if(old && old.id!==e.editingId){
    askConfirm('رکورد تکراری','برای این تاریخ و وعده رکوردی وجود دارد. آن را با این اطلاعات جایگزین می‌کنید؟',function(){saveEntry(key,people,total);});
    return;
  }
  saveEntry(key,people,total);
}
function saveEntry(key,people,total){
  const e=state.entry;
  const row={id:e.editingId||uid(),key:key,jy:e.date.jy,jm:e.date.jm,jd:e.date.jd,meal:e.meal,people:people,total:Math.round(total),note:($('#inNote').value||'').trim(),updatedAt:new Date().toISOString()};
  const ix=state.records.findIndex(r=>r.id===row.id || (r.key===row.key && r.meal===row.meal));
  if(ix>=0)state.records[ix]=row; else state.records.push(row);
  saveRecords(); toast(e.editingId?'ویرایش ذخیره شد.':'هزینه ثبت شد.');
  clearEntry(); navigate('dashboard'); renderAll();
}

/* ---------- ناوبری و پیام‌ها ---------- */
let toastTimer=null, confirmCallback=null;
function toast(msg){
  const el=$('#toast'); if(!el)return;
  el.textContent=msg; el.classList.add('show');
  clearTimeout(toastTimer); toastTimer=setTimeout(()=>el.classList.remove('show'),2600);
}
function askConfirm(title,body,yes){
  $('#modalTitle').textContent=title; $('#modalBody').textContent=body;
  $('#modal').hidden=false; confirmCallback=yes;
}
function closeModal(){ $('#modal').hidden=true; confirmCallback=null; }
function navigate(view){
  state.view=view;
  $$('.view').forEach(v=>v.classList.toggle('active',v.id==='view-'+view));
  $$('.nav-btn').forEach(b=>b.classList.toggle('active',b.dataset.view===view));
  if(view==='dashboard')viewDashboard();
  if(view==='list')viewList();
  if(view==='stats')viewStats();
  if(view==='settings')viewSettings();
  window.scrollTo({top:0,behavior:'smooth'});
}
function renderAll(){
  viewDashboard(); viewList(); viewStats(); viewSettings();
}

/* ---------- تنظیمات ---------- */
function viewSettings(){
  const l=$('#setLunch'), b=$('#setBreakfast'), sm=$('#setSmooth');
  if(l && document.activeElement!==l) l.value=fmtMoney(cap('lunch'));
  if(b && document.activeElement!==b) b.value=fmtMoney(cap('breakfast'));
  if(sm) sm.value=String(Number(state.settings.smooth)?1:0);
  const box=$('#allStats');
  if(box){
    const t=0,p=0;
    let tt=0,pp=0,nn=state.records.length;
    state.records.forEach(r=>{tt+=r.total;pp+=r.people;});
    box.innerHTML='<div class="kpi"><div class="kpi-label">کل رکوردها</div><div class="kpi-value">'+faNum(nn)+'</div></div>'+
      '<div class="kpi"><div class="kpi-label">کل هزینه‌ها</div><div class="kpi-value">'+fmtMoney(tt)+' <span class="unit">تومان</span></div><div class="kpi-sub">'+faNum(pp)+' نفر-روز</div></div>';
  }
}
function saveSettingsUI(){
  const l=parseNum($('#setLunch').value), b=parseNum($('#setBreakfast').value), sm=$('#setSmooth').value;
  if(!(isFinite(l)&&l>0)||!(isFinite(b)&&b>0)){ toast('سقف‌ها باید عددهای مثبت باشند.'); return; }
  state.settings.lunch=Math.round(l); state.settings.breakfast=Math.round(b);
  state.settings.smooth=Number(sm)?1:0;
  saveSettings(); toast('تنظیمات ذخیره شد.'); viewSettings(); renderAll();
}
/* ---------- پشتیبان JSON ---------- */
function exportJSON(){
  const blob=new Blob([JSON.stringify({app:'moeood',version:1,exportedAt:new Date().toISOString(),settings:state.settings,records:state.records},null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='moeood-backup-'+jKey(todayJalali())+'.json';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(a.href),3000);
  toast('فایل پشتیبان دانلود شد.');
}
function importJSON(file){
  const rd=new FileReader();
  rd.onload=function(){
    try{
      const o=JSON.parse(rd.result);
      const recs=Array.isArray(o)?o:(Array.isArray(o.records)?o.records:null);
      if(!recs) throw 0;
      const clean=recs.filter(r=>r&&r.key&&r.meal&&MEALS[r.meal]&&r.people>0&&isFinite(r.total));
      askConfirm('ورود پشتیبان',faNum(clean.length)+' رکورد معتبر یافت شد. با رکوردهای فعلی ادغام شود؟',function(){
        clean.forEach(r=>{
          const ix=state.records.findIndex(x=>x.key===r.key&&x.meal===r.meal);
          if(ix>=0) state.records[ix]=r; else state.records.push(r);
        });
        if(o&&o.settings&&Number(o.settings.lunch)>0&&Number(o.settings.breakfast)>0){
          state.settings=Object.assign({},DEFAULTS,o.settings); saveSettings();
        }
        saveRecords(); closeModal(); toast('پشتیبان با موفقیت وارد شد.'); renderAll();
      });
    }catch(e){ toast('فایل پشتیبان معتبر نیست.'); }
  };
  rd.readAsText(file,'utf-8');
}
function addSample(){
  const t=todayJalali(); const st=weekStartKey(t);
  const sample=[
    {off:0,meal:'lunch',people:7,total:1750000,note:'چلوکباب'},
    {off:0,meal:'breakfast',people:9,total:720000,note:'نان و پنیر و چای'},
    {off:1,meal:'lunch',people:6,total:1560000,note:'قورمه‌سبزی'},
    {off:1,meal:'breakfast',people:8,total:640000,note:''},
    {off:2,meal:'lunch',people:8,total:2080000,note:'زیتون‌پلو'},
    {off:2,meal:'breakfast',people:10,total:850000,note:'املت'}
  ];
  let added=0;
  sample.forEach(s=>{
    const j=addDaysJ(st,s.off); if(!mealAllowed(s.meal,j))return;
    const k=jKey(j);
    if(recordFor(k,s.meal))return;
    state.records.push({id:uid(),key:k,jy:j.jy,jm:j.jm,jd:j.jd,meal:s.meal,people:s.people,total:s.total,note:s.note,updatedAt:new Date().toISOString()});
    added++;
  });
  saveRecords(); toast(faNum(added)+' رکورد نمونه اضافه شد.'); renderAll();
}
function wipeAll(){
  askConfirm('حذف همه داده‌ها','همهٔ رکوردهای ثبت‌شده برای همیشه حذف می‌شوند. مطمئن هستید؟ (قبل از حذف، از پشتیبان JSON استفاده کنید)',function(){
    state.records=[]; saveRecords(); closeModal(); toast('همهٔ داده‌ها حذف شد.'); renderAll();
  });
}
/* ---------- رویدادها ---------- */
function goStepFrom(n){
  if(n>1 && !state.entry.date){ entryError('ابتدا تاریخ را انتخاب کنید.'); return; }
  if(n>2 && !state.entry.meal){ entryError('ابتدا وعده را انتخاب کنید.'); return; }
  if(n>3){
    const p=Number(state.entry.people);
    if(!Number.isInteger(p)||p<1){ entryError('تعداد نفرات را وارد کنید (حداقل ۱).'); return; }
  }
  showStep(n);
}
function fillQuick(){
  const box=$('#quickFill'); if(!box)return;
  const m=state.entry.meal;
  if(!m){ box.innerHTML=''; return; }
  const c=cap(m), s=suggestFor(state.entry.date||todayJalali(),m,Number(state.entry.people)||1);
  const chips=[[c,'سقف روزانه'],[Math.round(s.per),'پیشنهاد هفته'],[Math.round(c*0.9),'۹۰٪ سقف']];
  box.innerHTML=chips.map(ch=>'<button type="button" class="chip" data-fill="'+ch[0]+'">'+ch[1]+': '+fmtMoney(ch[0])+'</button>').join('');
}
function bindEvents(){
  $$('.nav-btn').forEach(b=>b.addEventListener('click',()=>navigate(b.dataset.view)));
  document.addEventListener('click',function(ev){
    const g=ev.target.closest('[data-goto]'); if(g){ navigate(g.dataset.goto); return; }
    const jp=ev.target.closest('[data-jp]'); if(jp){ movePicker(Number(jp.dataset.jp)); return; }
    const day=ev.target.closest('.jp-day'); if(day&&!day.disabled){ setEntryDate(keyToJ(day.dataset.date)); return; }
    const mo=ev.target.closest('.meal-opt'); if(mo&&!mo.disabled){ setEntryMeal(mo.dataset.meal); return; }
    const ppl=ev.target.closest('[data-people]');
    if(ppl){
      const cur=Number(state.entry.people)||0;
      setEntryPeople(Math.max(1,cur+Number(ppl.dataset.people))); return;
    }
    const fill=ev.target.closest('[data-fill]');
    if(fill){ $('#inTotal').value=faNum(fill.dataset.fill); $('#inTotal').dispatchEvent(new Event('input')); return; }
    const miss=ev.target.closest('[data-missing]');
    if(miss){ clearEntry(); setEntryMeal(miss.dataset.missing); showStep(4); navigate('entry'); return; }
    const ed=ev.target.closest('[data-edit]'); if(ed){ editRecord(ed.dataset.edit); return; }
    const dl=ev.target.closest('[data-del]');
    if(dl){
      const r=findRecord(dl.dataset.del); if(!r)return;
      askConfirm('حذف رکورد',byMealName(r.meal)+' '+fmtJFull(r)+' با هزینهٔ '+fmtMoney(r.total)+' تومان حذف شود؟',function(){
        state.records=state.records.filter(x=>x.id!==r.id); saveRecords(); closeModal(); toast('رکورد حذف شد.'); renderAll();
      });
      return;
    }
  });
  $('#btnNext').addEventListener('click',function(){
    if(state.entry.step<4){ goStepFrom(state.entry.step+1); if(state.entry.step===4) fillQuick(); }
    else submitEntry();
  });
  $('#btnBack').addEventListener('click',()=>showStep(state.entry.step-1));
  $('#btnCancelEdit').addEventListener('click',()=>{ clearEntry(); navigate('dashboard'); });
  $('#btnEditAnother').addEventListener('click',()=>{ clearEntry(); });
  $('#inPeople').addEventListener('input',function(){
    const v=parseNum(this.value);
    state.entry.people=(isFinite(v)&&v>0)?Math.floor(v):null;
    updateEntryUI();
  });
  $('#inTotal').addEventListener('input',function(){
    const people=Number(state.entry.people)||0, total=parseNum(this.value);
    const pl=$('#perPersonLive');
    if(pl) pl.textContent=(isFinite(total)&&total>=0&&people>0)
      ? 'سرانهٔ واقعی: '+fmtMoney(total/people)+' تومان برای هر نفر'+(state.entry.meal?' · سقف '+fmtMoney(cap(state.entry.meal)):'') : ' ';
  });
  ['fMeal','fMonth','fSort'].forEach(id=>{
    const el=$('#'+id); if(el) el.addEventListener('change',()=>{
      state.filter[id.slice(1).toLowerCase()]=$('#'+id).value; viewList();
    });
  });
  const fs=$('#fSearch'); if(fs) fs.addEventListener('input',()=>{ state.filter.search=fs.value; viewList(); });
  const sm2=$('#statsMonth'); if(sm2) sm2.addEventListener('change',()=>{ state.statsMonth=Number(sm2.value)||null; viewStats(); });
  $('#btnSaveSettings').addEventListener('click',saveSettingsUI);
  $('#btnExport').addEventListener('click',exportJSON);
  $('#fileImport').addEventListener('change',function(){ if(this.files&&this.files[0]) importJSON(this.files[0]); this.value=''; });
  $('#btnSample').addEventListener('click',addSample);
  $('#btnWipe').addEventListener('click',wipeAll);
  $('#modalYes').addEventListener('click',function(){ if(confirmCallback)confirmCallback(); else closeModal(); });
  $('#modalNo').addEventListener('click',closeModal);
  $('#modal').addEventListener('click',function(e){ if(e.target===this) closeModal(); });
  document.addEventListener('keydown',e=>{ if(e.key==='Escape'&&!$('#modal').hidden) closeModal(); });
}
/* ---------- شروع ---------- */
function init(){
  bindEvents();
  initPicker();
  clearEntry();
  navigate('dashboard');
}
init();
